---
import { nav, site, years, url } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-ink-800 bg-ink-900 text-ink-200">
  <div class="wrapper grid gap-12 py-16 md:grid-cols-3">
    <div>
      <div class="flex items-center gap-3">
        <img src={url('/img/logo-firmesa.png')} alt="" width="40" height="40" class="h-10 w-10" />
        <span class="font-display text-lg font-extrabold tracking-tight text-white">FIRMESA</span>
      </div>
      <p class="mt-4 max-w-xs text-sm leading-relaxed text-ink-400">
        {site.legalName}
      </p>
      <p class="mt-3 text-sm text-ink-400">{years()} años representando radiodifusoras mexicanas.</p>
    </div>

    <div>
      <h2 class="text-xs font-semibold uppercase tracking-[0.16em] text-ink-400">Navegación</h2>
      <ul class="mt-4 space-y-2.5">
        {
          nav.map(({ href, label }) => (
            <li>
              <a href={url(href)} class="text-sm text-ink-100 transition-colors hover:text-brand-300">
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <h2 class="text-xs font-semibold uppercase tracking-[0.16em] text-ink-400">Contacto</h2>
      <ul class="mt-4 space-y-2.5">
        {
          site.phones.map((phone) => (
            <li>
              <a href={`tel:+52${phone.replace(/\s/g, '')}`} class="text-sm text-ink-100 hover:text-brand-300">
                {phone}
              </a>
            </li>
          ))
        }
        {
          site.emails.map((email) => (
            <li>
              <a href={`mailto:${email}`} class="text-sm break-all text-ink-100 hover:text-brand-300">
                {email}
              </a>
            </li>
          ))
        }
        <li class="pt-2">
          <a href={site.facebook} rel="noopener noreferrer" target="_blank" class="text-sm text-ink-100 hover:text-brand-300">
            Facebook
          </a>
        </li>
      </ul>
    </div>
  </div>

  <div class="border-t border-ink-800">
    <p class="wrapper py-6 text-xs text-ink-400">
      © {year} {site.legalName} · Todos los derechos reservados.
    </p>
  </div>
</footer>
