---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { site, url } from '../data/site';
import states from '../data/stations.json';

const totalStations = states.reduce(
  (n, state) => n + state.cities.reduce((m, city) => m + city.stations.length, 0),
  0,
);
const totalCities = states.reduce((n, state) => n + state.cities.length, 0);

/** Search key: lowercased and stripped of accents. */
const normalize = (value: string) =>
  value.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();

const band = (frequency: string) => {
  const am = /\bAM\b/.test(frequency);
  const fm = /\bFM\b/.test(frequency);
  return am && fm ? 'AM · FM' : am ? 'AM' : 'FM';
};
---

<Base
  title="Nuestras estaciones"
  path="/estaciones/"
  description={`Directorio de las ${totalStations} radiodifusoras representadas por Firmesa en ${states.length} estados de México: frecuencia, siglas, programación y transmisión en vivo.`}
>
  <PageHeader
    eyebrow="Cobertura nacional"
    title="Nuestras estaciones"
    intro={`${totalStations} radiodifusoras en ${totalCities} ciudades de ${states.length} estados. Consulte frecuencia, siglas, programación y escuche cada señal en vivo.`}
  />

  <!-- Coverage map -->
  <section class="wrapper py-12">
    <div class="overflow-hidden rounded-lg border border-ink-200">
      <iframe
        src={site.coverageMap}
        title="Mapa de cobertura de las estaciones de Firmesa"
        loading="lazy"
        class="h-[440px] w-full"
      ></iframe>
    </div>
  </section>

  <!-- Filters -->
  <section class="sticky top-18 z-30 border-y border-ink-100 bg-white/95 backdrop-blur">
    <div class="wrapper flex flex-wrap items-center gap-4 py-4">
      <div class="min-w-56 flex-1">
        <label for="search" class="sr-only">Buscar estación, ciudad o programación</label>
        <input
          id="search"
          type="search"
          placeholder="Buscar estación, ciudad, siglas o programación…"
          autocomplete="off"
          class="w-full rounded-md border border-ink-200 bg-white px-4 py-2.5 text-sm text-ink-900 placeholder:text-ink-400 focus:border-brand-600 focus:outline-none"
        />
      </div>

      <div>
        <label for="state-filter" class="sr-only">Filtrar por estado</label>
        <select
          id="state-filter"
          class="rounded-md border border-ink-200 bg-white px-4 py-2.5 text-sm font-medium text-ink-900 focus:border-brand-600 focus:outline-none"
        >
          <option value="">Todos los estados</option>
          {states.map((state) => <option value={state.state}>{state.state}</option>)}
        </select>
      </div>

      <p id="result-count" class="text-sm text-ink-400" aria-live="polite">
        {totalStations} estaciones
      </p>
    </div>
  </section>

  <!-- Directory -->
  <div class="wrapper py-12">
    {
      states.map((state) => (
        <section data-state={state.state} class="mb-16">
          <h2 class="font-display text-2xl font-extrabold text-ink-900 md:text-3xl">
            {state.state}
          </h2>

          {state.cities.map((city) => (
            <div data-city class="mt-10">
              <h3 class="text-xs font-semibold uppercase tracking-[0.16em] text-brand-600">
                {city.city}
              </h3>

              <ul class="mt-4 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
                {city.stations.map((station) => (
                  <li
                    data-station
                    data-search={normalize(
                      [
                        station.name,
                        station.callSign,
                        station.frequency,
                        station.programming,
                        city.city,
                        state.state,
                      ].join(' '),
                    )}
                    class="flex h-full flex-col rounded-lg border border-ink-200 bg-white p-6 transition-colors hover:border-brand-300"
                  >
                    <div class="flex items-start justify-between gap-4">
                      <h4 class="font-display text-lg font-bold leading-tight text-ink-900">
                        {station.name}
                      </h4>
                      <span class="shrink-0 rounded bg-brand-50 px-2 py-1 text-[0.6875rem] font-bold uppercase tracking-wider text-brand-700">
                        {band(station.frequency)}
                      </span>
                    </div>

                    <p class="mt-2 font-display text-xl font-extrabold text-brand-600">
                      {station.frequency}
                    </p>
                    <p class="mt-1 text-xs font-medium uppercase tracking-[0.12em] text-ink-400">
                      {station.callSign}
                    </p>
                    <p class="mt-4 flex-1 text-sm leading-relaxed text-ink-600">
                      {station.programming}
                    </p>

                    <a
                      href={station.stream}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-brand-600 hover:text-brand-700"
                    >
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <path d="M8 5v14l11-7z" />
                      </svg>
                      Escuchar en vivo
                      <span class="sr-only">— {station.name}, {city.city}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </section>
      ))
    }

    <p id="no-results" hidden class="py-16 text-center text-ink-400">
      No encontramos estaciones con esos criterios. Pruebe con otra ciudad o tipo de programación.
    </p>
  </div>

  <section class="bg-brand-600">
    <div class="wrapper flex flex-wrap items-center justify-between gap-8 py-14">
      <h2 class="max-w-xl font-display text-2xl font-extrabold text-white md:text-3xl">
        ¿No encuentra su plaza? Escríbanos y revisamos alternativas de cobertura.
      </h2>
      <a
        href={url('/contacto/')}
        class="rounded-md bg-white px-6 py-3.5 text-sm font-semibold text-brand-700 transition-colors hover:bg-brand-50"
      >
        Contactar a Firmesa
      </a>
    </div>
  </section>
</Base>

<script>
  const searchInput = document.getElementById('search') as HTMLInputElement | null;
  const stateFilter = document.getElementById('state-filter') as HTMLSelectElement | null;
  const resultCount = document.getElementById('result-count');
  const noResults = document.getElementById('no-results');
  const sections = Array.from(document.querySelectorAll<HTMLElement>('[data-state]'));

  const normalize = (value: string) =>
    value.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();

  function applyFilters() {
    const term = normalize(searchInput?.value.trim() ?? '');
    const state = stateFilter?.value ?? '';
    let visible = 0;

    for (const section of sections) {
      const stateMatches = !state || section.dataset.state === state;
      let inSection = 0;

      for (const group of section.querySelectorAll<HTMLElement>('[data-city]')) {
        let inGroup = 0;

        for (const card of group.querySelectorAll<HTMLElement>('[data-station]')) {
          const matches = stateMatches && (!term || (card.dataset.search ?? '').includes(term));
          card.hidden = !matches;
          if (matches) inGroup++;
        }

        group.hidden = inGroup === 0;
        inSection += inGroup;
      }

      section.hidden = inSection === 0;
      visible += inSection;
    }

    // Visible copy stays in Spanish.
    if (resultCount) {
      resultCount.textContent = visible === 1 ? '1 estación' : `${visible} estaciones`;
    }
    if (noResults) noResults.hidden = visible > 0;
  }

  searchInput?.addEventListener('input', applyFilters);
  stateFilter?.addEventListener('change', applyFilters);
</script>
