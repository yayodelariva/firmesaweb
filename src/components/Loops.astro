---
/**
 * La «cadena para textura» del manual de identidad, página 16: la marca en
 * contorno, tendida detrás del contenido.
 *
 * Es el dibujo del manual, no una reconstrucción. Se intentó levantarlo como
 * geometría —doce arcos medidos sobre la página— y reproducía el 79.5% del
 * trazo original, con un 4% dibujado donde el manual no tiene nada. Para la
 * marca de la casa eso no alcanza, así que aquí va el dibujo mismo.
 *
 * Entra como máscara, no como imagen, para que siga tomando el color de quien
 * la pinta: el archivo es blanco con el trazo en el canal alfa, y lo que se
 * ve es `currentColor` recortado por él.
 *
 * Decorativa: va detrás, a poca opacidad.
 */
import { url } from '../lib/links';

interface Props {
  class?: string;
  /** Opacidad del trazo, 0–1. */
  opacity?: number;
  /**
   * Grados de inclinación. Ladeada, las cintas cruzan la banda en diagonal,
   * pero `cover` ya deja el dibujo tan alto como su caja, así que girarlo
   * siempre cuesta recorte: sólo vale la pena donde sobra alto. En una banda
   * de 450 px se ve menos de la mitad del dibujo; en un hero, casi todo.
   */
  tilt?: number;
  /**
   * Tamaño sobre el dibujo entero: 1 es la cadena completa, tan grande como
   * quepa en la banda. Por debajo de 1 se encoge y deja aire alrededor; por
   * encima se sale por los bordes y la banda enseña sólo un trozo.
   *
   * La base es el dibujo completo y no un recorte suyo, así que la banda ya
   * no decide qué parte se ve: decide cuánto espacio tiene.
   */
  zoom?: number;
  /**
   * Qué parte del dibujo queda en el centro de la banda, como
   * `mask-position`. Ampliadas y todas centradas, las doce secciones
   * enseñarían el mismo par de círculos; moviendo el encuadre, cada una se
   * queda con un tramo distinto —un remate, un cruce, una cinta—.
   */
  position?: string;
  /**
   * Corrimiento del dibujo entero sobre la banda, en los ejes de la página:
   * `'110px'` lo lleva 110 px a la derecha, `'0 -40px'` lo sube.
   *
   * Es otra cosa que `position`. El encuadre mueve el dibujo dentro de su
   * caja, y la caja lo recorta: con `contain` el dibujo queda tan ancho como
   * la banda, así que correrlo de lado le come por un borde lo que le deja
   * libre por el otro. Esto mueve la caja con el dibujo dentro, de modo que
   * el trazo llega entero a su nuevo sitio —hasta donde la sección, que sí
   * recorta, se lo permita—.
   *
   * Va primero en la lista de transformaciones, que es como se aplica al
   * final: así son píxeles de la página y no del dibujo ladeado, y el
   * corrimiento no cambia al cambiar la inclinación.
   */
  offset?: string;
}
const {
  class: className = '',
  opacity = 0.28,
  tilt = 0,
  zoom = 1,
  position = 'center',
  offset = '',
} = Astro.props;

const mudanza = offset ? `translate(${offset})` : '';
const postura = tilt || zoom !== 1 ? `scale(${zoom}) rotate(${tilt}deg)` : '';
const giro =
  mudanza || postura ? `;transform:${[mudanza, postura].filter(Boolean).join(' ')}` : '';

/* El lienzo del archivo es más ancho que el dibujo —2600 contra 1200, con el
   dibujo centrado—, porque las bandas del sitio son mucho más anchas que
   altas y `cover` se comería las cintas en vez del aire. */
const cadena = url('/img/cadena-textura.png');
---

<div
  class:list={['cadena pointer-events-none absolute inset-0', className]}
  style={`opacity:${opacity};--cadena:url('${cadena}');--encuadre:${position}${giro}`}
  aria-hidden="true"
>
</div>

<style>
  .cadena {
    background-color: currentColor;
    -webkit-mask-image: var(--cadena);
    mask-image: var(--cadena);
    /* `contain`: la cadena entera dentro de la banda, sin deformarse. Lo que
       la agranda o la encoge es el `scale` de cada sección. */
    -webkit-mask-size: contain;
    mask-size: contain;
    -webkit-mask-position: var(--encuadre);
    mask-position: var(--encuadre);
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
  }
</style>
