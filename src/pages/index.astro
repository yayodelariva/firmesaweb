---
import Base from '../layouts/Base.astro';
import Loops from '../components/Loops.astro';
import { worlds, territory, model360, sectors, decades, url } from '../data/site';

const rotating = ['campañas', 'marcas', 'posicionamiento'];
---

<Base title="Inicio" path="/">
  <!-- Hero -->
  <section class="relative overflow-hidden bg-ink-900">
    <img
      src={url('/img/hero-inicio.jpg')}
      alt=""
      class="absolute inset-0 h-full w-full object-cover opacity-45"
      fetchpriority="high"
    />
    <div class="absolute inset-0 bg-gradient-to-br from-ink-900 via-ink-900/80 to-brand-900/85"></div>
    <Loops class="text-white" opacity={0.16} />

    <div class="wrapper relative py-24 text-center md:py-32">
      <p class="pill mx-auto text-white/70">Desde 1972</p>

      <!-- Outlined wordmark, as in the deck -->
      <p
        class="mt-10 select-none text-[3.5rem] font-black leading-none tracking-[0.02em] text-transparent sm:text-8xl lg:text-[9rem]"
        style="-webkit-text-stroke: 2px rgba(255,255,255,0.9);"
        aria-hidden="true"
      >
        FIRMESA
      </p>

      <h1 class="mt-10 text-3xl font-extrabold leading-tight text-white sm:text-4xl md:text-5xl">
        <span class="sr-only">Creamos campañas, marcas y posicionamiento.</span>
        <span aria-hidden="true" class="block">Creamos</span>
        <span aria-hidden="true" class="rotator mt-2 grid justify-items-center">
          {
            rotating.map((word, i) => (
              <span class="col-start-1 row-start-1 text-brand-300" style={`--i:${i}`}>
                {word}
              </span>
            ))
          }
        </span>
      </h1>

      <p class="mx-auto mt-8 max-w-2xl text-lg leading-relaxed text-ink-200">
        No se trata de estar en todos lados. <strong class="font-bold text-white">Se trata de estar donde importa.</strong>
      </p>

      <div class="mt-10 flex flex-wrap justify-center gap-4">
        <a
          href={url('/contacto/')}
          class="rounded-full bg-brand-600 px-8 py-4 text-xs font-bold uppercase tracking-[0.18em] text-white transition-colors hover:bg-brand-500"
        >
          Hablemos de tu proyecto
        </a>
        <a
          href={url('/medios-masivos/')}
          class="rounded-full border border-white/40 px-8 py-4 text-xs font-bold uppercase tracking-[0.18em] text-white transition-colors hover:bg-white/10"
        >
          Conoce lo que hacemos
        </a>
      </div>
    </div>
  </section>

  <!-- Positioning statement -->
  <section class="bg-white">
    <div class="wrapper max-w-4xl py-20 text-center md:py-24">
      <p class="text-xl leading-relaxed text-ink-800 md:text-2xl">
        Firmesa es la <strong class="font-extrabold">central de medios y partner estratégico</strong>
        {' '}que posiciona marcas con precisión.
      </p>
      <p class="mt-6 text-xl leading-relaxed text-ink-600 md:text-2xl">
        <strong class="font-extrabold text-brand-600">Más de {decades()} años construyendo marcas.</strong>
        {' '}Hoy, integrando medios masivos y digitales en un solo sistema.
      </p>
    </div>
  </section>

  <!-- Lo mejor de dos mundos -->
  <section class="relative overflow-hidden bg-ink-900">
    <img src={url('/img/textura-acustica.jpg')} alt="" class="absolute inset-0 h-full w-full object-cover opacity-25" loading="lazy" />
    <div class="absolute inset-0 bg-ink-900/70"></div>

    <div class="relative">
      <div class="band py-4">
        <h2 class="wrapper statement text-center text-sm text-white md:text-base">
          Lo mejor de dos mundos
        </h2>
      </div>

      <div class="wrapper grid gap-8 py-16 md:grid-cols-2 md:py-20">
        {
          worlds.map(({ label, href, image, text }) => (
            <a href={url(href)} class="group block">
              <div class="overflow-hidden rounded-3xl border border-white/15">
                <div class="relative">
                  <img
                    src={url(image)}
                    alt=""
                    loading="lazy"
                    class="h-64 w-full object-cover transition-transform duration-500 group-hover:scale-105 md:h-72"
                  />
                  <div class="absolute inset-0 flex items-center justify-center bg-ink-900/25">
                    <span class="pill bg-ink-900/40 text-white backdrop-blur-sm">{label}</span>
                  </div>
                </div>
              </div>
              <p class="mt-6 text-xl font-bold leading-snug text-white md:text-2xl">{text}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Territorio -->
  <section class="bg-field">
    <div class="band relative overflow-hidden py-5">
      <Loops class="text-white" opacity={0.2} />
      <h2 class="wrapper statement relative text-center text-sm text-white md:text-base">Territorio</h2>
    </div>

    <div class="wrapper grid gap-6 py-16 md:grid-cols-3 md:py-20">
      {
        territory.map(({ title, image }) => (
          <article class="overflow-hidden rounded-3xl bg-white shadow-sm">
            <img src={url(image)} alt="" loading="lazy" class="h-64 w-full object-cover" />
            <h3 class="band px-6 py-6 text-center text-lg font-extrabold uppercase leading-snug tracking-wide text-white">
              {title}
            </h3>
          </article>
        ))
      }
    </div>
  </section>

  <!-- La integramos -->
  <section class="relative overflow-hidden bg-ink-900">
    <img src={url('/img/integramos.jpg')} alt="" loading="lazy" class="absolute inset-0 h-full w-full object-cover opacity-40" />
    <div class="absolute inset-0 bg-ink-900/55"></div>

    <div class="relative py-20 md:py-24">
      <div class="bg-field/95 py-8">
        <div class="wrapper text-center">
          <p class="statement text-sm text-ink-600 md:text-xl">
            No dividimos la <span class="text-brand-600">comunicación</span>
          </p>
          <p class="mt-2 text-4xl font-black uppercase tracking-tight text-brand-600 md:text-6xl">
            La integramos
          </p>
        </div>
      </div>

      <p class="wrapper mt-10 max-w-4xl text-center text-xl leading-relaxed text-white md:text-2xl">
        Estrategia, data, creatividad, medios y ejecución trabajando juntos para lograr resultados
        reales.
      </p>
    </div>
  </section>

  <!-- Modelo 360 -->
  <section class="bg-white">
    <div class="band relative overflow-hidden py-14">
      <Loops class="text-white" opacity={0.18} />
      <div class="wrapper relative text-center">
        <p class="pill mx-auto text-white/80">Modelo 360°</p>
        <p class="statement mt-6 text-lg text-white md:text-2xl">Las marcas no crecen por partes.</p>
      </div>
    </div>

    <div class="wrapper py-16 md:py-20">
      <p class="text-center text-sm font-bold uppercase tracking-[0.2em] text-ink-400">
        Por eso integramos
      </p>
      <ul class="mt-8 flex flex-wrap justify-center gap-3">
        {
          model360.map((item) => (
            <li class="pill border-brand-600 text-brand-600">{item}</li>
          ))
        }
      </ul>

      <div class="mt-14 grid gap-4 text-center md:grid-cols-2">
        <p class="band rounded-2xl px-6 py-8 text-2xl font-black uppercase tracking-[0.12em] text-white">
          Todo conectado
        </p>
        <p class="rounded-2xl bg-field px-6 py-8 text-2xl font-black uppercase tracking-[0.12em] text-brand-600">
          Todo alineado
        </p>
      </div>
    </div>
  </section>

  <!-- Clientes -->
  <section class="bg-field">
    <div class="wrapper py-16 text-center md:py-20">
      <p class="pill mx-auto border-ink-300 text-ink-800">Clientes / Casos de éxito</p>
      <p class="mx-auto mt-8 max-w-2xl text-xl text-ink-800">
        Trabajamos con marcas que entienden que crecer requiere estrategia.
      </p>
      <ul class="mt-10 flex flex-wrap justify-center gap-3">
        {
          sectors.map((sector) => (
            <li class="rounded-full bg-ink-300/70 px-7 py-3 text-sm font-bold uppercase tracking-[0.14em] text-white">
              {sector}
            </li>
          ))
        }
      </ul>
      <p class="statement mt-14 text-sm text-brand-600 md:text-xl">
        Cada proyecto parte de una decisión
      </p>
    </div>
    <div class="band py-5">
      <p class="wrapper statement text-center text-sm text-white md:text-base">
        Nuestro trabajo es que esa decisión funcione
      </p>
    </div>
  </section>

  <!-- Insights -->
  <section class="relative overflow-hidden">
    <img src={url('/img/insights.jpg')} alt="" loading="lazy" class="h-72 w-full object-cover md:h-96" />
    <div class="band py-10">
      <div class="wrapper text-center">
        <p class="pill mx-auto text-white/85">Entender el mercado es parte del trabajo</p>
        <p class="mt-6 text-lg text-white md:text-xl">
          Compartimos visión, análisis y tendencias para tomar mejores decisiones.
        </p>
      </div>
    </div>
  </section>

  <!-- Cierre -->
  <section class="relative overflow-hidden bg-ink-900">
    <img src={url('/img/cierre-tablet.jpg')} alt="" loading="lazy" class="absolute inset-0 h-full w-full object-cover opacity-35" />
    <div class="absolute inset-0 bg-ink-900/60"></div>

    <div class="wrapper relative py-20 text-center md:py-28">
      <p class="statement text-lg text-white md:text-3xl">
        Cuando la estrategia es correcta<br />la ejecución es contundente
      </p>
      <a
        href={url('/contacto/')}
        class="mt-10 inline-block rounded-full bg-white px-8 py-4 text-xs font-bold uppercase tracking-[0.18em] text-brand-700 transition-colors hover:bg-brand-50"
      >
        Agenda una llamada estratégica
      </a>
    </div>
  </section>
</Base>

<style>
  /* Rotating word in the hero headline. */
  .rotator > span {
    opacity: 0;
    animation: rotate-word 7.5s infinite;
    animation-delay: calc(var(--i) * 2.5s);
  }

  /* Three words, 2.5 s each: one is always on screen, including at t=0. */
  @keyframes rotate-word {
    0%, 28% { opacity: 1; transform: translateY(0); }
    34%, 100% { opacity: 0; transform: translateY(-0.3em); }
  }

  @media (prefers-reduced-motion: reduce) {
    .rotator > span { animation: none; opacity: 0; }
    .rotator > span:first-child { opacity: 1; }
  }
</style>
