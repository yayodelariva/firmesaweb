---
import Loops from './Loops.astro';
import { nav, site, decades, url } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="relative overflow-hidden bg-ink-900 text-ink-200">
  <Loops class="text-white" opacity={0.09} />

  <div class="wrapper relative grid gap-12 py-16 md:grid-cols-3 md:py-20">
    <div>
      <img
        src={url('/img/logo-firmesa-blanco.png')}
        alt={site.name}
        width="190"
        height="62"
        class="h-10 w-auto"
      />
      <p class="mt-6 max-w-xs leading-relaxed text-ink-300">
        Central de medios y partner estratégico. Más de {decades()} años construyendo marcas.
      </p>
      <p class="mt-4 text-sm text-ink-400">{site.legalName}</p>
    </div>

    <div>
      <h2 class="text-xs font-bold uppercase tracking-[0.2em] text-ink-400">Navegación</h2>
      <ul class="mt-5 space-y-3">
        {
          nav.map(({ href, label }) => (
            <li>
              <a href={url(href)} class="text-sm font-semibold text-white transition-colors hover:text-brand-300">
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <h2 class="text-xs font-bold uppercase tracking-[0.2em] text-ink-400">Contacto</h2>
      <ul class="mt-5 space-y-3">
        {
          site.phones.map((phone) => (
            <li>
              <a href={`tel:+52${phone.replace(/\s/g, '')}`} class="text-sm text-white hover:text-brand-300">
                {phone}
              </a>
            </li>
          ))
        }
        {
          site.emails.map((email) => (
            <li>
              <a href={`mailto:${email}`} class="text-sm break-all text-white hover:text-brand-300">
                {email}
              </a>
            </li>
          ))
        }
        <li class="pt-1 text-sm text-ink-300">{site.location}</li>
        <li class="pt-2">
          <a href={site.facebook} rel="noopener noreferrer" target="_blank" class="text-sm text-white hover:text-brand-300">
            Facebook
          </a>
        </li>
      </ul>
    </div>
  </div>

  <div class="band">
    <p class="wrapper py-5 text-xs text-white/80">
      © {year} {site.legalName} · Todos los derechos reservados.
    </p>
  </div>
</footer>
