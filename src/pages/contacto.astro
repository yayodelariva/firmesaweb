---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { site } from '../data/site';

const primaryEmail = site.emails[0];
---

<Base
  title="Contacto"
  path="/contacto/"
  description="Contacte a Firmesa para cotizar una campaña de radio, solicitar tarifas o producir su spot. Teléfonos, correos y formulario."
>
  <PageHeader
    eyebrow="Contacto"
    title="Hablemos de su próxima campaña."
    intro="Cuéntenos a quién quiere llegar, en qué plazas y con qué presupuesto. Le preparamos una propuesta de pauta con tarifas vigentes."
  />

  <section class="wrapper py-16 md:py-24">
    <div class="grid gap-14 lg:grid-cols-[1fr_1.1fr]">
      <!-- Direct contact details -->
      <div>
        <h2 class="font-display text-2xl font-bold text-ink-900">Atención directa</h2>

        <div class="mt-8 space-y-8">
          <div>
            <h3 class="text-xs font-semibold uppercase tracking-[0.16em] text-ink-400">Teléfonos</h3>
            <ul class="mt-3 space-y-2">
              {
                site.phones.map((phone) => (
                  <li>
                    <a
                      href={`tel:+52${phone.replace(/\s/g, '')}`}
                      class="font-display text-xl font-bold text-ink-900 hover:text-brand-600"
                    >
                      {phone}
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>

          <div>
            <h3 class="text-xs font-semibold uppercase tracking-[0.16em] text-ink-400">
              Correo electrónico
            </h3>
            <ul class="mt-3 space-y-2">
              {
                site.emails.map((email) => (
                  <li>
                    <a href={`mailto:${email}`} class="break-all text-lg text-ink-900 hover:text-brand-600">
                      {email}
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>

          <div>
            <h3 class="text-xs font-semibold uppercase tracking-[0.16em] text-ink-400">Redes</h3>
            <p class="mt-3">
              <a
                href={site.facebook}
                target="_blank"
                rel="noopener noreferrer"
                class="text-lg text-ink-900 hover:text-brand-600"
              >
                Facebook · @firmesaoficial
              </a>
            </p>
          </div>
        </div>

        <div class="mt-10 rounded-lg border border-ink-200 bg-ink-50 p-6">
          <p class="text-sm leading-relaxed text-ink-600">
            Para producción de spots, jingles o podcast, escriba directamente a
            <a href={`mailto:${primaryEmail}`} class="font-semibold text-brand-600">
              {primaryEmail}
            </a>
            e indique el material que necesita.
          </p>
        </div>
      </div>

      <!-- Form. Field names stay in Spanish: they label the submissions Firmesa staff read. -->
      <div class="rounded-lg border border-ink-200 bg-white p-8 md:p-10">
        <h2 class="font-display text-2xl font-bold text-ink-900">Cuéntenos qué necesita</h2>

        <form
          id="contact-form"
          class="mt-8 space-y-6"
          method="post"
          action={site.formEndpoint || undefined}
        >
          <div>
            <label for="nombre" class="block text-sm font-semibold text-ink-800">
              Nombre <span class="text-brand-600" aria-hidden="true">*</span>
            </label>
            <input
              id="nombre"
              name="nombre"
              type="text"
              required
              autocomplete="name"
              class="mt-2 w-full rounded-md border border-ink-200 px-4 py-3 text-ink-900 focus:border-brand-600 focus:outline-none"
            />
          </div>

          <div class="grid gap-6 sm:grid-cols-2">
            <div>
              <label for="correo" class="block text-sm font-semibold text-ink-800">
                Correo electrónico <span class="text-brand-600" aria-hidden="true">*</span>
              </label>
              <input
                id="correo"
                name="correo"
                type="email"
                required
                autocomplete="email"
                class="mt-2 w-full rounded-md border border-ink-200 px-4 py-3 text-ink-900 focus:border-brand-600 focus:outline-none"
              />
            </div>
            <div>
              <label for="telefono" class="block text-sm font-semibold text-ink-800">Teléfono</label>
              <input
                id="telefono"
                name="telefono"
                type="tel"
                autocomplete="tel"
                class="mt-2 w-full rounded-md border border-ink-200 px-4 py-3 text-ink-900 focus:border-brand-600 focus:outline-none"
              />
            </div>
          </div>

          <div>
            <label for="interes" class="block text-sm font-semibold text-ink-800">Me interesa</label>
            <select
              id="interes"
              name="interes"
              class="mt-2 w-full rounded-md border border-ink-200 bg-white px-4 py-3 text-ink-900 focus:border-brand-600 focus:outline-none"
            >
              <option>Pauta en radio</option>
              <option>Tarifario vigente</option>
              <option>Producción de spot o jingle</option>
              <option>Podcast o audio para marca</option>
              <option>Publicidad en autobuses</option>
              <option>Otro</option>
            </select>
          </div>

          <div>
            <label for="mensaje" class="block text-sm font-semibold text-ink-800">
              Mensaje <span class="text-brand-600" aria-hidden="true">*</span>
            </label>
            <textarea
              id="mensaje"
              name="mensaje"
              rows="5"
              required
              class="mt-2 w-full rounded-md border border-ink-200 px-4 py-3 text-ink-900 focus:border-brand-600 focus:outline-none"
            ></textarea>
          </div>

          <button
            type="submit"
            class="w-full rounded-md bg-brand-600 px-6 py-3.5 text-sm font-semibold text-white transition-colors hover:bg-brand-700"
          >
            Enviar mensaje
          </button>

          <p class="text-xs leading-relaxed text-ink-400">
            Al enviar acepta que Firmesa use sus datos únicamente para dar respuesta a esta
            solicitud.
          </p>
        </form>
      </div>
    </div>
  </section>
</Base>

<script is:inline define:vars={{ endpoint: site.formEndpoint, recipient: primaryEmail }}>
  // With no endpoint configured, the form opens the visitor's mail client instead.
  if (!endpoint) {
    const form = document.getElementById('contact-form');

    form?.addEventListener('submit', (event) => {
      event.preventDefault();
      const data = new FormData(form);

      // Labels stay in Spanish: Firmesa staff read these messages.
      const body = [
        `Nombre: ${data.get('nombre') ?? ''}`,
        `Correo: ${data.get('correo') ?? ''}`,
        `Teléfono: ${data.get('telefono') || 'No proporcionado'}`,
        `Interés: ${data.get('interes') ?? ''}`,
        '',
        String(data.get('mensaje') ?? ''),
      ].join('\n');

      const subject = `Solicitud desde firmesa.mx — ${data.get('interes') ?? 'Contacto'}`;
      window.location.href =
        `mailto:${recipient}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
    });
  }
</script>
