---
import Base from '../layouts/Base.astro';
import Backdrop from '../components/Backdrop.astro';
import BandHeading from '../components/BandHeading.astro';
import Loops from '../components/Loops.astro';
import {
  massBestSellers,
  services,
  formats,
  media,
  radio,
  movingMedia,
  movingMediaTraits,
} from '../data/content';
import { url } from '../lib/links';
---

<Base
  title="Medios Masivos"
  path="/medios-masivos/"
  description="Nuestra base es el radio y nuestra capacidad es mucho mayor: campañas en radio con presencia nacional, parabuses y exterior, aviones, autobuses e impresos."
>
  <!-- Hero -->
  <section class="relative overflow-hidden bg-brand-800">
    <Loops class="text-white" opacity={0.2} />
    <div class="absolute inset-0 band opacity-95"></div>

    <div class="wrapper relative py-20 text-center md:py-28">
      <p class="pill mx-auto text-white/75">Medios Masivos</p>
      <h1 class="statement mx-auto mt-8 max-w-4xl text-xl text-white md:text-4xl">
        Nuestra base es el radio<br />
        <span class="font-normal tracking-[0.06em]">Nuestra capacidad es mucho mayor</span>
      </h1>
      <p class="pill mx-auto mt-10 text-white/85">Entendemos los medios desde su esencia</p>
    </div>

    <p class="relative bg-field py-5 text-center text-base text-ink-800 md:text-xl">
      Cómo funcionan, cómo se consumen y cómo generan impacto.
    </p>
  </section>

  <!-- Nuestros medios -->
  <section class="bg-white">
    <div class="wrapper py-16 md:py-20">
      <p class="pill w-fit border-ink-800 text-ink-900">Nuestros medios</p>

      <ul class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          media.map(({ title, image }) => (
            <li class="group relative overflow-hidden rounded-3xl">
              <img
                src={url(image)}
                alt=""
                loading="lazy"
                decoding="async"
                class="h-56 w-full object-cover transition-transform duration-500 group-hover:scale-105"
              />
              <div class="absolute inset-0 flex items-end bg-gradient-to-t from-brand-900/85 to-transparent p-6">
                <h2 class="text-2xl font-black uppercase tracking-tight text-white">{title}</h2>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Radio -->
  <section class="relative overflow-hidden bg-brand-900">
    <Backdrop image="/img/bs-radio.jpg" imageClass="opacity-25" overlayClass="bg-brand-900/70" />

    <div class="wrapper relative grid items-center gap-12 py-16 md:py-24 lg:grid-cols-2">
      <div>
        <h2
          class="text-outline text-5xl font-black uppercase tracking-tight md:text-7xl"
          style="--outline-width: 1.5px; --outline-color: rgb(255 255 255 / 0.95);"
        >
          Radio
        </h2>
        <p class="mt-8 max-w-md text-lg leading-relaxed text-white/90">{radio.text}</p>

        <p class="mt-10 flex items-baseline gap-5 border-l-2 border-brand-400 pl-5">
          <span class="text-5xl font-black text-white md:text-6xl">{radio.figure}</span>
          <span class="text-sm font-bold uppercase tracking-[0.16em] text-white/80">
            {radio.figureLabel}
          </span>
        </p>
      </div>

      <!-- How a radio buy is run, in the order the deck lists it. -->
      <ol class="grid gap-3 sm:grid-cols-2">
        {
          radio.steps.map((step, i) => (
            <li class="flex items-center gap-4 rounded-2xl border border-white/20 px-5 py-4">
              <span class="text-xs font-black text-brand-400">{String(i + 1).padStart(2, '0')}</span>
              <span class="text-sm font-bold uppercase tracking-[0.12em] text-white">{step}</span>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Medios en movimiento -->
  <section class="bg-field">
    <div class="wrapper py-16 md:py-20">
      <!-- Same outlined display heading as Radio, in crimson: the white
           outline of the Radio version would vanish on this light field. -->
      <h2
        class="text-outline text-center text-5xl font-black uppercase tracking-tight md:text-7xl"
        style="--outline-width: 1.5px; --outline-color: var(--color-brand-500);"
      >
        Medios en movimiento
      </h2>

      <p class="mx-auto mt-10 max-w-2xl text-center text-xl leading-relaxed text-ink-800 md:text-2xl">
        Llevamos a las marcas más lejos, en cada etapa del viaje.
      </p>

      <div class="mt-12 grid gap-6 md:grid-cols-2">
        {
          movingMedia.map(({ title, formats }) => (
            <article class="rounded-3xl bg-white p-8 shadow-sm">
              <h3 class="text-sm font-black uppercase tracking-[0.16em] text-brand-500">{title}</h3>
              <ul class="mt-6 space-y-3">
                {formats.map((format) => (
                  <li class="flex gap-3 text-ink-600">
                    <span class="mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-brand-500" />
                    <span>{format}</span>
                  </li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>

      <ul class="mt-10 flex flex-wrap justify-center gap-3">
        {movingMediaTraits.map((trait) => <li class="pill border-ink-800 text-ink-900">{trait}</li>)}
      </ul>
    </div>
  </section>

  <!-- Formatos -->
  <section class="bg-white">
    <div class="wrapper py-16 md:py-20">
      <div class="grid gap-6 md:grid-cols-2">
        {
          formats.map(({ title, image }) => (
            <article class="group relative overflow-hidden rounded-3xl">
              <img
                src={url(image)}
                alt=""
                loading="lazy"
                decoding="async"
                class="h-80 w-full object-cover transition-transform duration-500 group-hover:scale-105"
              />
              <div class="absolute inset-0 flex items-end bg-brand-900/30 p-8">
                <h2
                  class="text-outline text-4xl font-black uppercase tracking-tight md:text-5xl"
                  style="--outline-width: 1.5px; --outline-color: rgb(255 255 255 / 0.95);"
                >
                  {title}
                </h2>
              </div>
            </article>
          ))
        }
      </div>

      <p class="statement mt-12 text-center text-base text-brand-500 md:text-2xl">
        Planeamos, negociamos y ejecutamos con precisión
      </p>
    </div>
  </section>

  <!-- Best sellers masivos -->
  <section class="bg-field">
    <BandHeading class="py-6" headingClass="text-sm md:text-xl">Best sellers masivos</BandHeading>

    <p class="wrapper py-6 text-center text-lg text-brand-700 md:text-xl">
      Presencia estratégica en los espacios que construyen alcance real.
    </p>

    <div class="wrapper grid gap-6 pb-16 sm:grid-cols-2 lg:grid-cols-4 md:pb-20">
      {
        massBestSellers.map(({ title, subtitle, text, image }) => (
          <article class="overflow-hidden rounded-3xl bg-white shadow-sm">
            <img src={url(image)} alt="" loading="lazy" decoding="async" class="h-52 w-full object-cover" />
            <div class="p-6">
              <p class="text-xs font-bold uppercase tracking-[0.16em] text-brand-500">{subtitle}</p>
              <h3 class="mt-2 text-lg font-extrabold leading-snug text-ink-900">{title}</h3>
              <p class="mt-3 leading-relaxed text-ink-600">{text}</p>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <!-- Servicios -->
  <section class="relative overflow-hidden bg-brand-900">
    <Backdrop image="/img/consola.jpg" imageClass="opacity-30" overlayClass="bg-brand-900/60" />

    <div class="wrapper relative py-16 md:py-24">
      <p class="pill w-fit text-white/85">Servicios</p>
      <ul class="mt-10 max-w-3xl space-y-3">
        {
          services.map((service, i) => (
            <li
              class:list={[
                'border-b border-white/15 pb-4 text-lg uppercase tracking-[0.1em] text-white md:text-xl',
                i % 2 === 0 ? 'font-extrabold' : 'font-light',
              ]}
            >
              {service}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Cierre -->
  <section class="bg-field">
    <div class="wrapper py-16 text-center md:py-20">
      <p class="statement text-base text-ink-900 md:text-2xl">Cada espacio tiene un propósito</p>
      <p class="statement mt-3 text-base text-brand-500 md:text-2xl">
        Cada inversión tiene una lógica
      </p>

      <p class="statement mt-12 text-base text-ink-900 md:text-2xl">
        Cuando una marca necesita escala
      </p>
      {/* El logotipo va en su archivo de marca: el manual lo fija en Avenir
          Next Heavy, no en la tipografía del sitio. */}
      <img
        src={url('/img/logo-firmesa.png')}
        alt="Firmesa"
        width="760"
        height="248"
        loading="lazy"
        decoding="async"
        class="mx-auto mt-6 h-auto w-64 md:w-80"
      />
      <p class="statement mt-3 text-base text-brand-500 md:text-2xl">sabe cómo construirla</p>

      <a href={url('/contacto/')} class="btn btn-brand mt-12">Hablemos de tu proyecto</a>
    </div>
  </section>
</Base>
