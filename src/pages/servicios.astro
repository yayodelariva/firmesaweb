---
import Base from '../layouts/Base.astro';
import EncabezadoPagina from '../components/EncabezadoPagina.astro';
import { servicios } from '../data/site';

const imagenes: Record<string, string> = {
  representacion: '/img/digital-radio.jpg',
  estudio: '/img/estudio.jpg',
};
---

<Base
  titulo="Servicios"
  ruta="/servicios/"
  descripcion="Representación de radiodifusoras, agencia de publicidad y contratación de medios, estudio de grabación digital y audio para marcas."
>
  <EncabezadoPagina
    eyebrow="Servicios"
    titulo="Todo lo que su campaña necesita para sonar."
    entrada="Desde la creatividad y la producción del spot hasta la compra de espacios y la distribución del material a cada estación."
  />

  <div class="contenedor divide-y divide-ink-100">
    {
      servicios.map(({ slug, titulo, resumen, detalle, puntos }, i) => (
        <section id={slug} class="scroll-mt-24 py-16 md:py-20">
          <div class="grid gap-12 lg:grid-cols-[1fr_1.1fr] lg:items-start">
            <div>
              <p class="font-display text-sm font-bold text-brand-600">
                {String(i + 1).padStart(2, '0')}
              </p>
              <h2 class="mt-3 font-display text-3xl font-extrabold leading-tight text-ink-900">
                {titulo}
              </h2>
              <p class="mt-5 text-lg leading-relaxed text-ink-600">{resumen}</p>
              {imagenes[slug] && (
                <img
                  src={imagenes[slug]}
                  alt=""
                  loading="lazy"
                  class="mt-8 w-full rounded-lg border border-ink-200 object-cover"
                />
              )}
            </div>

            <div class="rounded-lg border border-ink-200 bg-ink-50 p-8 md:p-10">
              <p class="leading-relaxed text-ink-600">{detalle}</p>
              <ul class="mt-8 space-y-4">
                {puntos.map((p) => (
                  <li class="flex gap-3.5">
                    <svg
                      width="20"
                      height="20"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.5"
                      class="mt-0.5 shrink-0 text-brand-600"
                      aria-hidden="true"
                    >
                      <path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                    <span class="text-ink-800">{p}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </section>
      ))
    }
  </div>

  <section class="border-t border-ink-100 bg-ink-900">
    <div class="contenedor py-16 md:py-20">
      <div class="grid gap-10 lg:grid-cols-2 lg:items-center">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.22em] text-brand-300">Tarifas</p>
          <h2 class="mt-3 font-display text-3xl font-extrabold text-white">
            Tarifas vigentes de radio y autobuses
          </h2>
          <p class="mt-5 leading-relaxed text-ink-200">
            Manejamos tarifas por estación, plaza y horario, además de publicidad en autobuses.
            Solicite el tarifario del año en curso y le enviamos la propuesta que corresponda a su
            plan de medios.
          </p>
        </div>
        <div class="lg:justify-self-end">
          <a
            href="/contacto/"
            class="inline-block rounded-md bg-brand-600 px-6 py-3.5 text-sm font-semibold text-white transition-colors hover:bg-brand-500"
          >
            Solicitar tarifario
          </a>
        </div>
      </div>
    </div>
  </section>
</Base>
