---
import Base from '../layouts/Base.astro';
import Loops from '../components/Loops.astro';
import { site, url } from '../data/site';

const primaryEmail = site.emails[0];
---

<Base
  title="Contacto"
  path="/contacto/"
  description="Las marcas que crecen no improvisan. Agenda una llamada estratégica con Firmesa: teléfonos, correo y formulario. Polanco, CDMX."
>
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div class="band absolute inset-0"></div>
    <Loops class="text-white" opacity={0.22} />

    <div class="wrapper relative py-20 text-center md:py-28">
      <p class="pill mx-auto text-white/80">Contacto</p>
      <h1 class="statement mx-auto mt-8 max-w-4xl text-xl text-white md:text-4xl">
        Las marcas que crecen no improvisan
      </h1>
      <p class="pill mx-auto mt-8 border-white/70 px-8 text-base normal-case tracking-normal text-white md:text-xl">
        Empiezan con una conversación clara.
      </p>
    </div>
  </section>

  <section class="bg-white">
    <div class="wrapper grid gap-14 py-16 md:py-24 lg:grid-cols-[1fr_1.15fr]">
      <!-- Datos directos -->
      <div>
        <h2 class="text-2xl font-extrabold text-ink-900">Atención directa</h2>

        <dl class="mt-10 space-y-9">
          <div>
            <dt class="text-xs font-bold uppercase tracking-[0.2em] text-ink-400">Teléfono</dt>
            <dd class="mt-3 space-y-1">
              {
                site.phones.map((phone) => (
                  <a
                    href={`tel:+52${phone.replace(/\s/g, '')}`}
                    class="block text-2xl font-extrabold text-ink-900 transition-colors hover:text-brand-600"
                  >
                    {phone}
                  </a>
                ))
              }
            </dd>
          </div>

          <div>
            <dt class="text-xs font-bold uppercase tracking-[0.2em] text-ink-400">
              Correo electrónico
            </dt>
            <dd class="mt-3 space-y-1">
              {
                site.emails.map((email) => (
                  <a
                    href={`mailto:${email}`}
                    class="block break-all text-lg text-ink-900 transition-colors hover:text-brand-600"
                  >
                    {email}
                  </a>
                ))
              }
            </dd>
          </div>

          <div>
            <dt class="text-xs font-bold uppercase tracking-[0.2em] text-ink-400">Ubicación</dt>
            <dd class="mt-3 text-lg font-bold text-ink-900">{site.location}</dd>
          </div>

          <div>
            <dt class="text-xs font-bold uppercase tracking-[0.2em] text-ink-400">Redes</dt>
            <dd class="mt-3">
              <a
                href={site.facebook}
                target="_blank"
                rel="noopener noreferrer"
                class="text-lg text-ink-900 transition-colors hover:text-brand-600"
              >
                Facebook · @firmesaoficial
              </a>
            </dd>
          </div>
        </dl>
      </div>

      <!-- Form. Field names stay in Spanish: they label the submissions Firmesa staff read. -->
      <div class="rounded-3xl border border-ink-200 bg-field/50 p-8 md:p-10">
        <h2 class="text-2xl font-extrabold text-ink-900">Cuéntanos de tu proyecto</h2>

        <form
          id="contact-form"
          class="mt-8 space-y-6"
          method="post"
          action={site.formEndpoint || undefined}
        >
          <div>
            <label for="nombre" class="block text-xs font-bold uppercase tracking-[0.16em] text-ink-600">
              Nombre <span class="text-brand-600" aria-hidden="true">*</span>
            </label>
            <input
              id="nombre"
              name="nombre"
              type="text"
              required
              autocomplete="name"
              class="mt-2 w-full rounded-xl border border-ink-200 bg-white px-4 py-3 text-ink-900 focus:border-brand-600 focus:outline-none"
            />
          </div>

          <div class="grid gap-6 sm:grid-cols-2">
            <div>
              <label for="empresa" class="block text-xs font-bold uppercase tracking-[0.16em] text-ink-600">
                Empresa
              </label>
              <input
                id="empresa"
                name="empresa"
                type="text"
                autocomplete="organization"
                class="mt-2 w-full rounded-xl border border-ink-200 bg-white px-4 py-3 text-ink-900 focus:border-brand-600 focus:outline-none"
              />
            </div>
            <div>
              <label for="telefono" class="block text-xs font-bold uppercase tracking-[0.16em] text-ink-600">
                Teléfono
              </label>
              <input
                id="telefono"
                name="telefono"
                type="tel"
                autocomplete="tel"
                class="mt-2 w-full rounded-xl border border-ink-200 bg-white px-4 py-3 text-ink-900 focus:border-brand-600 focus:outline-none"
              />
            </div>
          </div>

          <div>
            <label for="correo" class="block text-xs font-bold uppercase tracking-[0.16em] text-ink-600">
              Correo electrónico <span class="text-brand-600" aria-hidden="true">*</span>
            </label>
            <input
              id="correo"
              name="correo"
              type="email"
              required
              autocomplete="email"
              class="mt-2 w-full rounded-xl border border-ink-200 bg-white px-4 py-3 text-ink-900 focus:border-brand-600 focus:outline-none"
            />
          </div>

          <div>
            <label for="interes" class="block text-xs font-bold uppercase tracking-[0.16em] text-ink-600">
              Me interesa
            </label>
            <select
              id="interes"
              name="interes"
              class="mt-2 w-full rounded-xl border border-ink-200 bg-white px-4 py-3 text-ink-900 focus:border-brand-600 focus:outline-none"
            >
              <option>Estrategia y planeación</option>
              <option>Medios masivos</option>
              <option>Firmesa Digital</option>
              <option>Producción audiovisual</option>
              <option>Podcast</option>
              <option>Campaña 360°</option>
              <option>Otro</option>
            </select>
          </div>

          <div>
            <label for="mensaje" class="block text-xs font-bold uppercase tracking-[0.16em] text-ink-600">
              Mensaje <span class="text-brand-600" aria-hidden="true">*</span>
            </label>
            <textarea
              id="mensaje"
              name="mensaje"
              rows="5"
              required
              class="mt-2 w-full rounded-xl border border-ink-200 bg-white px-4 py-3 text-ink-900 focus:border-brand-600 focus:outline-none"
            ></textarea>
          </div>

          <button
            type="submit"
            class="w-full rounded-full bg-brand-600 px-6 py-4 text-xs font-bold uppercase tracking-[0.18em] text-white transition-colors hover:bg-brand-700"
          >
            Agenda una llamada estratégica
          </button>

          <p class="text-xs leading-relaxed text-ink-400">
            Al enviar aceptas que Firmesa use tus datos únicamente para dar respuesta a esta
            solicitud.
          </p>
        </form>
      </div>
    </div>
  </section>

  <section class="relative overflow-hidden bg-ink-900">
    <img src={url('/img/hablemos.jpg')} alt="" loading="lazy" class="absolute inset-0 h-full w-full object-cover opacity-40" />
    <div class="absolute inset-0 bg-ink-900/55"></div>
    <p class="wrapper relative py-20 text-center text-lg leading-relaxed text-white md:text-2xl">
      Cuando la estrategia es correcta, la ejecución es contundente.
    </p>
  </section>
</Base>

<script is:inline define:vars={{ endpoint: site.formEndpoint, recipient: primaryEmail }}>
  // With no endpoint configured, the form opens the visitor's mail client instead.
  if (!endpoint) {
    const form = document.getElementById('contact-form');

    form?.addEventListener('submit', (event) => {
      event.preventDefault();
      const data = new FormData(form);

      // Labels stay in Spanish: Firmesa staff read these messages.
      const body = [
        `Nombre: ${data.get('nombre') ?? ''}`,
        `Empresa: ${data.get('empresa') || 'No proporcionada'}`,
        `Correo: ${data.get('correo') ?? ''}`,
        `Teléfono: ${data.get('telefono') || 'No proporcionado'}`,
        `Interés: ${data.get('interes') ?? ''}`,
        '',
        String(data.get('mensaje') ?? ''),
      ].join('\n');

      const subject = `Solicitud desde firmesa.mx — ${data.get('interes') ?? 'Contacto'}`;
      window.location.href =
        `mailto:${recipient}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
    });
  }
</script>
