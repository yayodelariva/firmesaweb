---
import Base from '../layouts/Base.astro';
import Backdrop from '../components/Backdrop.astro';
import BandHeading from '../components/BandHeading.astro';
import Loops from '../components/Loops.astro';
import {
  digitalServices,
  digitalBestSellers,
  studioSpaces,
  studioImages,
} from '../data/content';
import { url } from '../lib/links';
---

<Base
  title="Firmesa Digital"
  path="/firmesa-digital/"
  description="Firmesa Digital es la unidad diseñada para construir posicionamiento en digital con estrategia, creatividad y contenido: producción audiovisual, contenido para redes, podcast, branding y pauta."
>
  <!-- Hero -->
  <section class="relative overflow-hidden bg-brand-900">
    <Backdrop
      image="/img/digital-que-es.jpg"
      imageClass="opacity-55"
      overlayClass="bg-gradient-to-t from-brand-900 via-brand-800/75 to-brand-900/40"
      priority
    />

    <div class="wrapper relative py-20 md:py-28">
      <img src={url('/img/logo-firmesa-blanco.png')} alt="" width="170" height="55" class="h-9 w-auto" />
      <p class="pill mt-8 text-white/75">¿Qué es?</p>
      <h1 class="mt-6 max-w-3xl text-3xl font-extrabold leading-tight text-white md:text-5xl">
        Firmesa Digital es la evolución de Firmesa hacia el entorno actual.
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-white/85">
        Una unidad diseñada para construir posicionamiento en digital con estrategia, creatividad y
        contenido.
      </p>
    </div>
  </section>

  <!-- ¿Qué hacemos? -->
  <section class="relative overflow-hidden bg-brand-500">
    <Loops class="text-white" opacity={0.14} />

    <div class="wrapper relative py-16 md:py-20">
      <p class="pill mx-auto block w-fit text-white">¿Qué hacemos?</p>

      <ul class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          digitalServices.map(({ title, image }) => (
            <li class="group relative overflow-hidden rounded-3xl">
              <img
                src={url(image)}
                alt=""
                loading="lazy"
                decoding="async"
                class="h-56 w-full object-cover transition-transform duration-500 group-hover:scale-105"
              />
              <div class="absolute inset-0 flex items-center justify-center bg-brand-900/45 p-4">
                <span class="pill border-white/80 bg-brand-900/35 text-center text-white backdrop-blur-sm">
                  {title}
                </span>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Best sellers -->
  <section class="bg-field">
    <BandHeading class="py-6" headingClass="text-sm md:text-xl">Best sellers digitales</BandHeading>

    <p class="wrapper py-6 text-center text-lg text-brand-700 md:text-xl">
      Formatos probados para generar conexión, posicionamiento y resultados.
    </p>

    <div class="wrapper grid gap-4 pb-16 sm:grid-cols-2 lg:grid-cols-5 md:pb-20">
      {
        digitalBestSellers.map(({ title, text, image }) => (
          <article class="relative overflow-hidden rounded-3xl bg-brand-900">
            <img src={url(image)} alt="" loading="lazy" decoding="async" class="h-[26rem] w-full object-cover opacity-70" />
            <div class="absolute inset-0 flex flex-col justify-between bg-gradient-to-b from-brand-900/60 via-transparent to-brand-900/90 p-5">
              <span class="pill border-white/70 text-center text-[0.625rem] tracking-[0.14em] text-white">
                {title}
              </span>
              <p class="text-center text-base font-bold leading-snug text-white">{text}</p>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <!-- Espacios de producción -->
  <section class="relative overflow-hidden bg-brand-900">
    <Loops class="text-white" opacity={0.1} />

    <div class="wrapper relative py-16 md:py-24">
      <p class="pill w-fit text-white/85">Nuestros espacios de producción</p>
      <p class="mt-8 max-w-xl text-xl leading-relaxed text-white md:text-2xl">
        Espacios propios para transformar ideas en contenido.
      </p>

      <div class="mt-12 grid gap-5 md:grid-cols-3">
        {
          studioImages.map(({ image, text }) => (
            <figure class="overflow-hidden rounded-3xl border border-white/15">
              <img
                src={url(image)}
                alt={text}
                loading="lazy"
                decoding="async"
                class="h-56 w-full object-cover"
              />
            </figure>
          ))
        }
      </div>

      <ul class="mt-10 flex flex-wrap gap-3">
        {studioSpaces.map((space) => <li class="pill text-white">{space}</li>)}
      </ul>

      <p class="statement mt-12 text-lg text-white md:text-2xl">Todo en un mismo lugar</p>
    </div>
  </section>

  <!-- Cierre -->
  <section class="relative overflow-hidden bg-brand-900">
    <Backdrop image="/img/mockup-edificio.jpg" imageClass="opacity-45" overlayClass="bg-brand-900/55" />

    <div class="wrapper relative py-20 text-center md:py-28">
      <p class="statement text-lg text-white md:text-3xl">
        Digital no es volumen<br />es dirección
      </p>
      <a href={url('/contacto/')} class="btn btn-light mt-10">Hablemos</a>
    </div>
  </section>
</Base>
