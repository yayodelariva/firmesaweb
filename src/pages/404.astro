---
import Base from '../layouts/Base.astro';
---

<Base titulo="Página no encontrada" ruta="/404/" descripcion="La página que busca no existe en firmesa.mx.">
  <section class="contenedor flex min-h-[60vh] flex-col items-center justify-center py-24 text-center">
    <p class="font-display text-6xl font-extrabold text-brand-600">404</p>
    <h1 class="mt-6 font-display text-3xl font-extrabold text-ink-900 md:text-4xl">
      Esta señal no está en el aire.
    </h1>
    <p class="mt-4 max-w-md leading-relaxed text-ink-600">
      La página que busca no existe o cambió de dirección. Puede volver al inicio o consultar el
      directorio de estaciones.
    </p>
    <div class="mt-10 flex flex-wrap justify-center gap-4">
      <a href="/" class="rounded-md bg-brand-600 px-6 py-3.5 text-sm font-semibold text-white hover:bg-brand-700">
        Ir al inicio
      </a>
      <a href="/estaciones/" class="rounded-md border border-ink-200 px-6 py-3.5 text-sm font-semibold text-ink-800 hover:bg-ink-50">
        Ver estaciones
      </a>
    </div>
  </section>
</Base>
