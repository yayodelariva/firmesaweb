---
import { nav, site, anios } from '../data/site';

const anio = new Date().getFullYear();
---

<footer class="mt-24 border-t border-ink-800 bg-ink-900 text-ink-200">
  <div class="contenedor grid gap-12 py-16 md:grid-cols-3">
    <div>
      <div class="flex items-center gap-3">
        <img src="/img/logo-firmesa.png" alt="" width="40" height="40" class="h-10 w-10" />
        <span class="font-display text-lg font-extrabold tracking-tight text-white">FIRMESA</span>
      </div>
      <p class="mt-4 max-w-xs text-sm leading-relaxed text-ink-400">
        {site.razonSocial}
      </p>
      <p class="mt-3 text-sm text-ink-400">{anios()} años representando radiodifusoras mexicanas.</p>
    </div>

    <div>
      <h2 class="text-xs font-semibold uppercase tracking-[0.16em] text-ink-400">Navegación</h2>
      <ul class="mt-4 space-y-2.5">
        {
          nav.map(({ href, label }) => (
            <li>
              <a href={href} class="text-sm text-ink-100 transition-colors hover:text-brand-300">
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <h2 class="text-xs font-semibold uppercase tracking-[0.16em] text-ink-400">Contacto</h2>
      <ul class="mt-4 space-y-2.5">
        {
          site.telefonos.map((t) => (
            <li>
              <a href={`tel:+52${t.replace(/\s/g, '')}`} class="text-sm text-ink-100 hover:text-brand-300">
                {t}
              </a>
            </li>
          ))
        }
        {
          site.correos.map((c) => (
            <li>
              <a href={`mailto:${c}`} class="text-sm break-all text-ink-100 hover:text-brand-300">
                {c}
              </a>
            </li>
          ))
        }
        <li class="pt-2">
          <a href={site.facebook} rel="noopener noreferrer" target="_blank" class="text-sm text-ink-100 hover:text-brand-300">
            Facebook
          </a>
        </li>
      </ul>
    </div>
  </div>

  <div class="border-t border-ink-800">
    <p class="contenedor py-6 text-xs text-ink-400">
      © {anio} {site.razonSocial} · Todos los derechos reservados.
    </p>
  </div>
</footer>
