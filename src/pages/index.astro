---
import Base from '../layouts/Base.astro';
import { site, servicios, anios, url } from '../data/site';
import estados from '../data/estaciones.json';

const totalEstados = estados.length;
const totalCiudades = estados.reduce((n, e) => n + e.ciudades.length, 0);
const totalEstaciones = estados.reduce(
  (n, e) => n + e.ciudades.reduce((m, c) => m + c.estaciones.length, 0),
  0,
);

const cifras = [
  { valor: `${anios()}`, etiqueta: 'años de vida comercial' },
  { valor: `${totalEstaciones}`, etiqueta: 'estaciones representadas' },
  { valor: `${totalCiudades}`, etiqueta: 'ciudades con cobertura' },
  { valor: `${totalEstados}`, etiqueta: 'estados de la República' },
];

const pilares = [
  {
    titulo: 'Radio',
    texto:
      'Nuestras radiodifusoras, ubicadas a lo largo y ancho del territorio nacional, permiten al anunciante seleccionar el área adecuada para difundir su campaña con la penetración e impacto de mayor efectividad.',
  },
  {
    titulo: 'Exclusividad',
    texto:
      'La mayoría de nuestras emisoras son únicas o líderes en su plaza. Donde otros medios no llegan, la radio sigue siendo la voz de la comunidad.',
  },
  {
    titulo: 'Cobertura global',
    texto:
      'Todas nuestras señales transmiten en vivo por internet, extendiendo el alcance de su mensaje mucho más allá del radio de la antena.',
  },
];
---

<Base titulo="Inicio" ruta="/">
  <!-- Hero -->
  <section class="relative overflow-hidden bg-ink-900">
    <img
      src={url('/img/hero-fondo.jpg')}
      alt=""
      class="absolute inset-0 h-full w-full object-cover opacity-20"
      fetchpriority="high"
    />
    <div class="absolute inset-0 bg-gradient-to-br from-ink-900 via-ink-900/95 to-brand-900/80"></div>

    <div class="contenedor relative py-24 md:py-32">
      <p class="text-xs font-semibold uppercase tracking-[0.22em] text-brand-300">
        Desde 1972 · Representación de radiodifusoras
      </p>
      <h1 class="mt-6 max-w-4xl font-display text-4xl font-extrabold leading-[1.05] text-white sm:text-5xl md:text-6xl">
        Su mensaje, al aire en la radio de todo México.
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink-200">
        Creamos, ejecutamos y distribuimos campañas publicitarias en estaciones únicas y líderes de
        cada plaza. Usted elige la audiencia; nosotros ponemos la señal.
      </p>

      <div class="mt-10 flex flex-wrap gap-4">
        <a
          href={url('/contacto/')}
          class="rounded-md bg-brand-600 px-6 py-3.5 text-sm font-semibold text-white transition-colors hover:bg-brand-500"
        >
          Cotizar una campaña
        </a>
        <a
          href={url('/estaciones/')}
          class="rounded-md border border-white/25 px-6 py-3.5 text-sm font-semibold text-white transition-colors hover:bg-white/10"
        >
          Ver estaciones y cobertura
        </a>
      </div>

      <dl class="mt-16 grid grid-cols-2 gap-8 border-t border-white/15 pt-10 md:grid-cols-4">
        {
          cifras.map(({ valor, etiqueta }) => (
            <div>
              <dt class="sr-only">{etiqueta}</dt>
              <dd>
                <span class="block font-display text-4xl font-extrabold text-white md:text-5xl">
                  {valor}
                </span>
                <span class="mt-2 block text-sm leading-snug text-ink-400">{etiqueta}</span>
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- Agradecimiento -->
  <section class="border-b border-ink-100 bg-brand-50">
    <div class="contenedor py-16 md:py-20">
      <blockquote class="mx-auto max-w-4xl text-center">
        <p class="font-display text-xl font-medium leading-relaxed text-ink-800 md:text-2xl">
          Al cumplir {anios()} años de vida comercial, reiteramos nuestro
          <strong class="text-brand-600">agradecimiento</strong> a los medios publicitarios, así como
          a todos los clientes y amigos, quienes con su confianza y apoyo nos permiten promover sus
          productos y servicios profesionales en beneficio del público en general.
        </p>
        <cite class="mt-6 block text-sm not-italic font-semibold uppercase tracking-[0.16em] text-ink-400">
          Firmesa
        </cite>
      </blockquote>
    </div>
  </section>

  <!-- Pilares -->
  <section class="contenedor py-20 md:py-28">
    <div class="grid gap-12 md:grid-cols-3">
      {
        pilares.map(({ titulo, texto }, i) => (
          <article>
            <span class="font-display text-sm font-bold text-brand-600">
              0{i + 1}
            </span>
            <h2 class="mt-3 font-display text-2xl font-bold text-ink-900">{titulo}</h2>
            <p class="mt-4 leading-relaxed text-ink-600">{texto}</p>
          </article>
        ))
      }
    </div>
  </section>

  <!-- Servicios -->
  <section class="border-y border-ink-100 bg-ink-50">
    <div class="contenedor py-20 md:py-28">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.22em] text-brand-600">Servicios</p>
          <h2 class="mt-3 font-display text-3xl font-extrabold text-ink-900 md:text-4xl">
            De la idea al aire, en una sola casa.
          </h2>
        </div>
        <a href={url('/servicios/')} class="text-sm font-semibold text-brand-600 hover:text-brand-700">
          Ver todos los servicios →
        </a>
      </div>

      <div class="mt-12 grid gap-6 md:grid-cols-2">
        {
          servicios.map(({ slug, titulo, resumen }) => (
            <a
              href={url(`/servicios/#${slug}`)}
              class="group rounded-lg border border-ink-200 bg-white p-8 transition-colors hover:border-brand-300"
            >
              <h3 class="font-display text-xl font-bold text-ink-900 group-hover:text-brand-600">
                {titulo}
              </h3>
              <p class="mt-3 leading-relaxed text-ink-600">{resumen}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Cobertura -->
  <section class="contenedor py-20 md:py-28">
    <div class="grid items-center gap-14 lg:grid-cols-2">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.22em] text-brand-600">Cobertura</p>
        <h2 class="mt-3 font-display text-3xl font-extrabold text-ink-900 md:text-4xl">
          {totalEstaciones} estaciones en {totalEstados} estados de la República.
        </h2>
        <p class="mt-5 leading-relaxed text-ink-600">
          Consulte el directorio completo con frecuencia, siglas, tipo de programación y enlace de
          transmisión en vivo de cada emisora. Filtre por estado o busque la plaza que le interesa.
        </p>
        <a
          href={url('/estaciones/')}
          class="mt-8 inline-block rounded-md bg-ink-900 px-6 py-3.5 text-sm font-semibold text-white transition-colors hover:bg-ink-800"
        >
          Abrir el directorio de estaciones
        </a>
      </div>

      <div class="overflow-hidden rounded-lg border border-ink-200">
        <iframe
          src={site.mapaCobertura}
          title="Mapa de cobertura de las estaciones de Firmesa"
          loading="lazy"
          class="h-[420px] w-full"
        ></iframe>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-brand-600">
    <div class="contenedor flex flex-wrap items-center justify-between gap-8 py-16">
      <div>
        <h2 class="font-display text-3xl font-extrabold text-white">¿Listo para salir al aire?</h2>
        <p class="mt-3 max-w-xl text-brand-100">
          Cuéntenos a quién quiere llegar y le preparamos una propuesta de pauta con tarifas
          vigentes.
        </p>
      </div>
      <a
        href={url('/contacto/')}
        class="rounded-md bg-white px-6 py-3.5 text-sm font-semibold text-brand-700 transition-colors hover:bg-brand-50"
      >
        Solicitar propuesta
      </a>
    </div>
  </section>
</Base>
