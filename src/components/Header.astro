---
import { nav, site } from '../data/site';
import { url, sitePath } from '../lib/links';

// Compared against the nav, so it must not carry the `base` prefix.
const current = sitePath(Astro.url.pathname);
const isActive = (href: string) => (href === '/' ? current === '/' : current.startsWith(href));
---

<header class="sticky top-0 z-50">
  <!-- Thin brand rule, as in the deck -->
  <div class="band h-1.5"></div>

  <div class="border-b border-ink-100 bg-white/95 backdrop-blur">
    <div class="wrapper flex h-20 items-center justify-between gap-6">
      <a href={url('/')} aria-label={`${site.name} — Inicio`} class="shrink-0">
        <img
          src={url('/img/logo-firmesa.png')}
          alt={site.name}
          width="190"
          height="62"
          class="h-10 w-auto md:h-11"
        />
      </a>

      <nav aria-label="Principal" class="hidden items-center gap-1 xl:flex">
        {
          nav.map(({ href, label }) => (
            <a
              href={url(href)}
              aria-current={isActive(href) ? 'page' : undefined}
              class:list={[
                'rounded-full px-4 py-2.5 text-sm font-semibold uppercase tracking-[0.08em] transition-colors',
                isActive(href)
                  ? 'bg-brand-600 text-white'
                  : 'text-ink-800 hover:bg-ink-50 hover:text-brand-600',
              ]}
            >
              {label}
            </a>
          ))
        }
      </nav>

      <button
        type="button"
        id="menu-button"
        class="inline-flex items-center gap-2 rounded-full border border-ink-200 px-4 py-2.5 text-xs font-bold uppercase tracking-[0.16em] text-ink-800 xl:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round" />
        </svg>
        Menú
      </button>
    </div>

    <nav id="mobile-menu" aria-label="Principal móvil" hidden class="border-t border-ink-100 bg-white xl:hidden">
      <ul class="wrapper flex flex-col py-2">
        {
          nav.map(({ href, label }) => (
            <li>
              <a
                href={url(href)}
                aria-current={isActive(href) ? 'page' : undefined}
                class:list={[
                  'block border-b border-ink-100 py-4 text-sm font-bold uppercase tracking-[0.12em]',
                  isActive(href) ? 'text-brand-600' : 'text-ink-800',
                ]}
              >
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  const button = document.getElementById('menu-button');
  const menu = document.getElementById('mobile-menu');

  const setOpen = (open: boolean) => {
    button?.setAttribute('aria-expanded', String(open));
    menu?.toggleAttribute('hidden', !open);
  };

  button?.addEventListener('click', () => {
    setOpen(button.getAttribute('aria-expanded') !== 'true');
  });

  // Escape closes the menu and returns focus to the control that opened it.
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && button?.getAttribute('aria-expanded') === 'true') {
      setOpen(false);
      button.focus();
    }
  });
</script>
