---
import Base from '../layouts/Base.astro';
import CoverageMap from '../components/CoverageMap.astro';
import Loops from '../components/Loops.astro';
import { stations as states } from '../data/stations';
import { url } from '../lib/links';
import { normalize, slug } from '../lib/text';

const totalStations = states.reduce(
  (n, state) => n + state.cities.reduce((m, city) => m + city.stations.length, 0),
  0,
);
const totalCities = states.reduce((n, state) => n + state.cities.length, 0);

const figures = [
  { figure: String(totalStations), label: 'Emisoras representadas' },
  { figure: String(totalCities), label: 'Ciudades' },
  { figure: String(states.length), label: 'Estados' },
];

/** `105.5 FM` → `FM`; la etiqueta corta que lleva cada tarjeta. */
const band = (frequency: string) => {
  const am = /\bAM\b/.test(frequency);
  const fm = /\bFM\b/.test(frequency);
  return am && fm ? 'AM · FM' : am ? 'AM' : 'FM';
};
---

<Base
  title="Nuestras estaciones"
  path="/estaciones/"
  description={`Directorio de las ${totalStations} radiodifusoras representadas por Firmesa en ${states.length} estados de México: mapa de cobertura, frecuencia, siglas, programación y transmisión en vivo.`}
>
  <section class="relative overflow-hidden bg-brand-900">
    <Loops class="text-white" opacity={0.12} tilt={-34} zoom={0.82} offset="110px" />

    <div class="wrapper relative py-16 md:py-24">
      <p class="pill w-fit text-white/75">Cobertura nacional</p>
      <h1 class="statement mt-8 max-w-3xl text-2xl text-white md:text-4xl">
        Nuestras estaciones
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-white/85">
        El radio es el origen de la casa y sigue siendo su columna. Este es el mapa de las plazas
        que representamos hoy, emisora por emisora.
      </p>

      <ul class="reveal mt-12 grid gap-6 sm:grid-cols-3">
        {
          figures.map(({ figure, label }, i) => (
            <li class="border-l-2 border-brand-400 pl-5" style={`--i: ${i}`}>
              <p class="text-5xl font-black text-white md:text-6xl">{figure}</p>
              <p class="mt-2 text-sm font-bold uppercase tracking-[0.16em] text-white/80">
                {label}
              </p>
            </li>
          ))
        }
      </ul>

      <div class="mt-14 max-w-4xl max-md:hidden">
        <CoverageMap />
      </div>
    </div>
  </section>

  <section
    id="directorio"
    class="sticky top-[87px] z-30 scroll-mt-[87px] border-b border-brand-500/15 bg-white/95 backdrop-blur"
  >
    <div class="wrapper flex flex-wrap items-center gap-4 py-4">
      <div class="min-w-56 flex-1">
        <label for="buscar" class="sr-only">Buscar estación, ciudad o programación</label>
        <input
          id="buscar"
          type="search"
          placeholder="Buscar estación, ciudad, siglas o programación…"
          autocomplete="off"
          class="field mt-0 text-sm"
        />
      </div>

      <div>
        <label for="filtro-estado" class="sr-only">Filtrar por estado</label>
        <select id="filtro-estado" class="field mt-0 w-auto text-sm font-semibold">
          <option value="">Todos los estados</option>
          {states.map((state) => <option value={state.state}>{state.state}</option>)}
        </select>
      </div>

      <button
        type="button"
        id="limpiar"
        hidden
        class="rounded-full border border-brand-500/30 px-4 py-2.5 text-xs font-bold uppercase tracking-[0.16em] text-brand-500 transition-colors hover:bg-brand-50"
      >
        Limpiar
      </button>

      <p
        id="conteo"
        class="text-sm font-semibold uppercase tracking-[0.12em] text-ink-400"
        aria-live="polite"
      >
        {totalStations} estaciones
      </p>
    </div>
  </section>

  <div class="wrapper py-16 md:py-20">
    {
      states.map((state) => (
        <section
          id={`estado-${slug(state.state)}`}
          data-state={state.state}
          class="mb-16 scroll-mt-40 last:mb-0"
        >
          <h2 class="border-b border-brand-500/20 pb-4 text-xl font-extrabold uppercase tracking-[0.1em] text-brand-500 md:text-2xl">
            {state.state}
          </h2>

          <ul class="mt-8 grid gap-5 md:grid-cols-2 xl:grid-cols-3">
            {state.cities.flatMap((city) =>
              city.stations.map((station, i) => (
                <li
                  id={i === 0 ? `ciudad-${slug(state.state)}-${slug(city.city)}` : undefined}
                  data-station
                  data-search={normalize(
                    [
                      station.name,
                      station.callSign,
                      station.frequency,
                      station.programming,
                      city.city,
                      state.state,
                    ].join(' '),
                  )}
                  class="flex h-full scroll-mt-40 flex-col rounded-3xl border border-brand-500/15 bg-white p-6 transition-colors hover:border-brand-500/40"
                >
                  <p class="text-xs font-bold uppercase tracking-[0.16em] text-ink-400">
                    {city.city}
                  </p>

                  <div class="mt-3 flex items-start justify-between gap-4">
                    <h3 class="text-lg font-extrabold leading-tight text-ink-900">
                      {station.name}
                    </h3>
                    <span class="shrink-0 rounded-full bg-brand-50 px-3 py-1 text-[0.625rem] font-bold uppercase tracking-[0.16em] text-brand-700">
                      {band(station.frequency)}
                    </span>
                  </div>

                  <p class="mt-3 text-2xl font-black text-brand-500">{station.frequency}</p>
                  <p class="mt-1 text-xs font-bold uppercase tracking-[0.16em] text-ink-400">
                    {station.callSign}
                  </p>
                  <p class="mt-4 flex-1 leading-relaxed text-ink-600">{station.programming}</p>

                  {station.audio ? (
                    <Fragment>
                      <button
                        type="button"
                        data-reproducir
                        data-audio={station.audio}
                        data-sitio={station.stream}
                        data-nombre={station.name}
                        data-ciudad={city.city}
                        data-ganancia={station.gain ?? 1}
                        class="-ml-3 mt-4 inline-flex cursor-pointer items-center gap-2 self-start rounded-full px-3 py-2 text-xs font-bold uppercase tracking-[0.16em] text-brand-500 transition-colors hover:bg-brand-50 hover:text-brand-700"
                      >
                        <svg
                          width="14"
                          height="14"
                          viewBox="0 0 24 24"
                          fill="currentColor"
                          aria-hidden="true"
                        >
                          <path class="icono-reproducir" d="M8 5v14l11-7z" />
                          <rect class="icono-detener" x="6" y="6" width="12" height="12" rx="1.5" />
                        </svg>
                        <span data-etiqueta>Escuchar en vivo</span>
                        <span class="sr-only">
                          — {station.name}, {city.city}
                        </span>
                      </button>
                      <noscript>
                        <a
                          href={station.stream}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="-ml-3 mt-4 inline-flex items-center gap-2 self-start rounded-full px-3 py-2 text-xs font-bold uppercase tracking-[0.16em] text-brand-500 transition-colors hover:bg-brand-50 hover:text-brand-700"
                        >
                          Escuchar en el sitio de la estación
                        </a>
                      </noscript>
                    </Fragment>
                  ) : (
                    <a
                      href={station.stream}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="-ml-3 mt-4 inline-flex items-center gap-2 self-start rounded-full px-3 py-2 text-xs font-bold uppercase tracking-[0.16em] text-brand-500 transition-colors hover:bg-brand-50 hover:text-brand-700"
                    >
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <path d="M14 3v2h3.59l-9.83 9.83 1.41 1.41L19 6.41V10h2V3h-7z" />
                        <path d="M19 19H5V5h5V3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-5h-2v5z" />
                      </svg>
                      Escuchar en su sitio
                      <span class="sr-only">
                        — {station.name}, {city.city}
                      </span>
                    </a>
                  )}

                  {!station.audio && !station.stream && (
                    <p class="mt-6 self-start text-xs font-bold uppercase tracking-[0.16em] text-ink-400">
                      Sólo al aire
                      <span class="sr-only">
                        — {station.name} no transmite por internet.
                      </span>
                    </p>
                  )}
                </li>
              )),
            )}
          </ul>
        </section>
      ))
    }

    <p id="sin-resultados" hidden class="py-16 text-center text-lg text-ink-400">
      No encontramos estaciones con esos criterios. Pruebe con otra ciudad o tipo de programación.
    </p>
  </div>

  <section class="relative overflow-hidden bg-brand-900">
    <div class="wrapper relative flex flex-wrap items-center justify-between gap-8 py-16 md:py-20">
      <p class="statement max-w-xl text-base text-white md:text-2xl">
        ¿No encuentra su plaza? Revisamos alternativas de cobertura
      </p>
      <a href={url('/contacto/')} class="btn btn-light">Hablemos de tu proyecto</a>
    </div>
  </section>

  <div
    id="reproductor"
    hidden
    class="fixed inset-x-0 bottom-0 z-40 border-t border-white/15 bg-brand-900/95 backdrop-blur"
  >
    <div class="wrapper flex items-center gap-4 py-3.5">
      <span id="reproductor-pulso" class="relative flex h-2.5 w-2.5 shrink-0" aria-hidden="true">
        <span class="absolute inline-flex h-full w-full rounded-full bg-brand-400 opacity-75"></span>
        <span class="relative inline-flex h-2.5 w-2.5 rounded-full bg-brand-400"></span>
      </span>

      <p class="min-w-0 flex-1 truncate text-sm text-white" aria-live="polite">
        <span id="reproductor-estado" class="text-white/55"></span>
        <span id="reproductor-nombre" class="font-bold"></span>
        <span id="reproductor-ciudad" class="text-white/55"></span>
      </p>

      <label class="flex shrink-0 items-center gap-2 text-white/55">
        <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M4 9h3.5L12 5v14L7.5 15H4z" fill="currentColor" />
          <path
            d="M15.5 9a4 4 0 0 1 0 6"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
          />
        </svg>
        <span class="sr-only">Volumen</span>
        <input
          id="reproductor-volumen"
          type="range"
          min="0"
          max="100"
          step="1"
          value="100"
          class="w-20 sm:w-28"
        />
      </label>

      <button
        type="button"
        id="reproductor-detener"
        class="shrink-0 rounded-full border border-white/30 px-4 py-2 text-xs font-bold uppercase tracking-[0.16em] text-white transition-colors hover:bg-white/10"
      >
        Detener
      </button>
    </div>
  </div>
</Base>

<script>
  import { normalize } from '../lib/text';

  const search = document.getElementById('buscar') as HTMLInputElement | null;
  const stateFilter = document.getElementById('filtro-estado') as HTMLSelectElement | null;
  const clear = document.getElementById('limpiar');
  const count = document.getElementById('conteo');
  const empty = document.getElementById('sin-resultados');
  // `section`, no `[data-state]` a secas: los enlaces del mapa llevan el
  // mismo atributo, y ocultarlos borraría el mapa al primer filtro.
  const sections = Array.from(document.querySelectorAll<HTMLElement>('section[data-state]'));

  function applyFilters() {
    const term = normalize(search?.value.trim() ?? '');
    const state = stateFilter?.value ?? '';
    let visible = 0;

    for (const section of sections) {
      const stateMatches = !state || section.dataset.state === state;
      let inSection = 0;

      for (const card of section.querySelectorAll<HTMLElement>('[data-station]')) {
        const matches = stateMatches && (!term || (card.dataset.search ?? '').includes(term));
        card.hidden = !matches;
        if (matches) inSection++;
      }

      section.hidden = inSection === 0;
      visible += inSection;
    }

    // El texto visible queda en español.
    if (count) count.textContent = visible === 1 ? '1 estación' : `${visible} estaciones`;
    if (empty) empty.hidden = visible > 0;
    clear?.toggleAttribute('hidden', !term && !state);
  }

  search?.addEventListener('input', applyFilters);
  stateFilter?.addEventListener('change', applyFilters);
  clear?.addEventListener('click', () => {
    if (search) search.value = '';
    if (stateFilter) stateFilter.value = '';
    applyFilters();
    search?.focus();
  });

  // El mapa ya salta al bloque correcto por sí solo. Esto sólo añade el
  // filtro, para que el estado elegido quede a solas en la página; el salto
  // lo sigue haciendo el enlace, después de que el filtro se haya aplicado.
  for (const link of document.querySelectorAll<SVGAElement>('svg a[data-state]')) {
    link.addEventListener('click', () => {
      if (stateFilter) stateFilter.value = link.dataset.state ?? '';
      if (search) search.value = '';
      applyFilters();
    });
  }

  /* ── Reproductor ──────────────────────────────────────────────────────── */

  // Un solo elemento de audio para toda la página: dos señales a la vez no
  // es algo que nadie quiera, y así cambiar de emisora cierra la anterior.
  const audio = new Audio();
  audio.preload = 'none';

  const bar = document.getElementById('reproductor');
  const barStatus = document.getElementById('reproductor-estado');
  const barName = document.getElementById('reproductor-nombre');
  const barCity = document.getElementById('reproductor-ciudad');
  const barStop = document.getElementById('reproductor-detener');
  const pulse = document.getElementById('reproductor-pulso');
  const volume = document.getElementById('reproductor-volumen') as HTMLInputElement | null;

  let playing: HTMLButtonElement | null = null;

  // Veinte decibeles separan a la emisora más fuerte de la más discreta, así
  // que cada ficha trae la atenuación que la deja a la par del resto
  // (`scripts/measure-loudness.py` las mide). El control sólo mueve lo ya
  // nivelado, y se recuerda para la próxima visita.
  const NIVEL = 'firmesa:volumen';
  let level = 1;
  try {
    const saved = localStorage.getItem(NIVEL);
    if (saved !== null) level = Math.min(1, Math.max(0, Number(saved) || 0));
  } catch {
    // Navegación privada: se queda con el nivel de fábrica.
  }
  if (volume) volume.value = String(Math.round(level * 100));

  function applyVolume() {
    const gain = Number(playing?.dataset.ganancia) || 1;
    // El oído no es lineal; al cuadrado, media carrera suena a media fuerza.
    audio.volume = Math.min(1, level * level * gain);
  }

  volume?.addEventListener('input', () => {
    level = Number(volume.value) / 100;
    applyVolume();
    try {
      localStorage.setItem(NIVEL, String(level));
    } catch {
      // Sin dónde guardarlo, el nivel vale para esta visita.
    }
  });

  const label = (button: HTMLButtonElement, text: string) => {
    const span = button.querySelector('[data-etiqueta]');
    if (span) span.textContent = text;
  };

  function stop() {
    audio.pause();
    // Sin esto la conexión al flujo sigue abierta y la emisora sigue
    // descargándose en silencio hasta que se cierra la pestaña.
    audio.removeAttribute('src');
    audio.load();

    if (playing) {
      playing.dataset.estado = '';
      label(playing, 'Escuchar en vivo');
      playing.setAttribute('aria-pressed', 'false');
      playing = null;
    }
    showBar(false);
  }

  // La barra queda fija sobre el pie de página; sin este hueco taparía la
  // última fila de fichas justo cuando se está eligiendo otra emisora.
  function showBar(visible: boolean) {
    bar?.toggleAttribute('hidden', !visible);
    document.body.style.paddingBottom = visible ? `${bar?.offsetHeight ?? 0}px` : '';
  }

  function start(button: HTMLButtonElement) {
    stop();
    playing = button;
    button.dataset.estado = 'cargando';
    button.setAttribute('aria-pressed', 'true');
    label(button, 'Conectando…');

    if (barStatus) barStatus.textContent = 'Conectando con ';
    if (barName) barName.textContent = button.dataset.nombre ?? '';
    if (barCity) barCity.textContent = button.dataset.ciudad ? `· ${button.dataset.ciudad}` : '';
    pulse?.removeAttribute('data-sonando');
    showBar(true);

    audio.src = button.dataset.audio ?? '';
    applyVolume();
    audio.play().catch(() => fail(button));
  }

  // Una emisora puede estar fuera del aire, o haber movido su flujo. Cuando
  // pasa, el botón deja de prometer sonido y ofrece el sitio de la emisora,
  // que es lo que había antes de que esto existiera.
  function fail(button: HTMLButtonElement) {
    const site = button.dataset.sitio;
    button.dataset.estado = 'error';
    button.setAttribute('aria-pressed', 'false');
    label(button, site ? 'Sin señal — abrir su sitio' : 'Sin señal por ahora');
    if (playing === button) playing = null;
    showBar(false);
  }

  audio.addEventListener('playing', () => {
    if (!playing) return;
    playing.dataset.estado = 'sonando';
    label(playing, 'Detener');
    if (barStatus) barStatus.textContent = 'Al aire: ';
    pulse?.setAttribute('data-sonando', '');
  });

  audio.addEventListener('error', () => {
    // El `src` vacío de `stop()` también dispara este evento; no es un fallo.
    if (playing && audio.getAttribute('src')) fail(playing);
  });

  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-reproducir]')) {
    button.setAttribute('aria-pressed', 'false');
    button.addEventListener('click', () => {
      if (button.dataset.estado === 'error') {
        if (button.dataset.sitio) window.open(button.dataset.sitio, '_blank', 'noopener');
        return;
      }
      if (playing === button) stop();
      else start(button);
    });
  }

  barStop?.addEventListener('click', stop);
</script>

<style>
  /* Llegar desde el mapa deja la ficha señalada: el salto por sí solo no
     dice cuál de las tres tarjetas del renglón era la que se pidió. */
  [data-station]:target {
    border-color: var(--color-brand-500);
    box-shadow: 0 0 0 3px rgb(149 25 54 / 0.12);
  }

  /* El icono sigue al estado del botón: triángulo en reposo, cuadro cuando
     la señal ya está sonando. */
  .icono-detener {
    display: none;
  }
  [data-estado='sonando'] .icono-reproducir {
    display: none;
  }
  [data-estado='sonando'] .icono-detener {
    display: inline;
  }
  [data-estado='cargando'] {
    opacity: 0.6;
  }
  [data-estado='error'] {
    color: var(--color-ink-400);
  }

  /* El punto late sólo mientras hay señal, no mientras se está conectando. */
  /* El control nativo no combina con la barra; el riel y el tirador sí. */
  #reproductor-volumen {
    appearance: none;
    height: 1.25rem;
    background: transparent;
  }

  /* En listas separadas: un navegador descarta toda la regla si no conoce
     uno de los selectores, y cada motor sólo conoce el suyo. */
  #reproductor-volumen::-webkit-slider-runnable-track {
    height: 3px;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.25);
  }

  #reproductor-volumen::-moz-range-track {
    height: 3px;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.25);
  }

  #reproductor-volumen::-webkit-slider-thumb {
    appearance: none;
    margin-top: -4.5px;
    height: 12px;
    width: 12px;
    border-radius: 999px;
    background: var(--color-brand-400);
  }

  #reproductor-volumen::-moz-range-thumb {
    border: 0;
    height: 12px;
    width: 12px;
    border-radius: 999px;
    background: var(--color-brand-400);
  }

  #reproductor-volumen:focus-visible {
    outline: 2px solid var(--color-brand-400);
    outline-offset: 4px;
  }

  #reproductor-pulso[data-sonando] > span:first-child {
    animation: ping 1.6s cubic-bezier(0, 0, 0.2, 1) infinite;
  }

  @keyframes ping {
    75%,
    100% {
      transform: scale(2.2);
      opacity: 0;
    }
  }
</style>
