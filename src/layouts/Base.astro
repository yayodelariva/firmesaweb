---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import { url, sitePath, telE164 } from '../lib/links';

interface Props {
  title: string;
  description?: string;
  /** Canonical path, e.g. "/firmesa-digital/". Never carries the `base` prefix. */
  path?: string;
  /** Keeps the page out of search results. */
  noindex?: boolean;
}

const {
  title,
  description = site.description,
  // `Astro.url.pathname` carries the `base` prefix and `url()` adds it again,
  // so the live path is reduced to a site-relative one first.
  path = sitePath(Astro.url.pathname),
  noindex = false,
} = Astro.props;
const fullTitle = path === '/' ? `${site.name} — ${site.tagline}` : `${title} | ${site.name}`;

// Real publication origin (Astro's `site` config); `site.domain` is the fallback.
const origin = Astro.site ?? new URL(site.domain);
/** Absolute URL for an internal path, honouring the deployment's `base`. */
const absolute = (p: string) => new URL(url(p), origin).href;
const canonical = absolute(path);
---

<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="icon" href={url('/img/marca.png')} type="image/png" />
    <meta name="theme-color" content="#951936" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="es_MX" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={absolute('/img/logo-firmesa.png')} />
    <meta property="og:image:alt" content={site.name} />
    <meta name="twitter:card" content="summary" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Nunito+Sans:opsz,wght@6..12,300;6..12,400;6..12,600;6..12,700;6..12,800;6..12,900&display=swap"
    />

    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'Organization',
        name: site.name,
        legalName: site.legalName,
        url: origin.href,
        logo: absolute('/img/logo-firmesa.png'),
        foundingDate: '1972-07-19',
        description: site.description,
        areaServed: 'MX',
        sameAs: [site.facebook],
        address: {
          '@type': 'PostalAddress',
          addressLocality: 'Polanco',
          addressRegion: 'Ciudad de México',
          addressCountry: 'MX',
        },
        // Omitted entirely while no phones are published: an empty
        // `contactPoint` array is worse structured data than no key at all.
        ...(site.phones.length > 0 && {
          contactPoint: site.phones.map((phone) => ({
            '@type': 'ContactPoint',
            telephone: telE164(phone),
            contactType: 'sales',
            areaServed: 'MX',
            availableLanguage: 'Spanish',
          })),
        }),
      })}
    />
  </head>

  <body class="antialiased">
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-full focus:bg-brand-500 focus:px-5 focus:py-2.5 focus:text-white"
    >
      Saltar al contenido
    </a>
    <Header />
    <main id="contenido">
      <slot />
    </main>
    <Footer />

    <script>
      // Drives every `.reveal` group on the site; see the rule in global.css.
      // Each one reveals when it is scrolled to, since an animation nobody is
      // looking at has already finished. Pages without one pay a query.
      for (const group of document.querySelectorAll<HTMLElement>('.reveal')) {
        group.dataset.reveal = 'pending';

        const observer = new IntersectionObserver(
          (entries) => {
            if (!entries.some((entry) => entry.isIntersecting)) return;
            group.dataset.reveal = 'in';
            observer.disconnect();
          },
          // Fires once the group's top clears the bottom fifth of the viewport.
          // A threshold would not do: a group can be taller than a phone
          // screen, and a fraction of it may never be on screen at once.
          { threshold: 0, rootMargin: '0px 0px -20% 0px' },
        );

        observer.observe(group);
      }
    </script>
  </body>
</html>
