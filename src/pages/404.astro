---
import Base from '../layouts/Base.astro';
import Loops from '../components/Loops.astro';
import { url } from '../data/site';
---

<Base title="Página no encontrada" path="/404/" description="La página que buscas no existe en firmesa.mx.">
  <section class="relative overflow-hidden bg-ink-900">
    <Loops class="text-white" opacity={0.14} />

    <div class="wrapper relative flex min-h-[65vh] flex-col items-center justify-center py-24 text-center">
      <p class="text-7xl font-black text-brand-500">404</p>
      <h1 class="statement mt-8 text-lg text-white md:text-2xl">Esta señal no está en el aire</h1>
      <p class="mt-6 max-w-md leading-relaxed text-ink-300">
        La página que buscas no existe o cambió de dirección.
      </p>
      <div class="mt-10 flex flex-wrap justify-center gap-4">
        <a
          href={url('/')}
          class="rounded-full bg-brand-600 px-8 py-4 text-xs font-bold uppercase tracking-[0.18em] text-white hover:bg-brand-500"
        >
          Ir al inicio
        </a>
        <a
          href={url('/contacto/')}
          class="rounded-full border border-white/40 px-8 py-4 text-xs font-bold uppercase tracking-[0.18em] text-white hover:bg-white/10"
        >
          Contacto
        </a>
      </div>
    </div>
  </section>
</Base>
