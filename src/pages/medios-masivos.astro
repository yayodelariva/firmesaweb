---
import Base from '../layouts/Base.astro';
import Backdrop from '../components/Backdrop.astro';
import BandHeading from '../components/BandHeading.astro';
import Outline from '../components/Outline.astro';
import Loops from '../components/Loops.astro';
import {
  massBestSellers,
  services,
  formats,
  media,
  radio,
  movingMedia,
  movingMediaTraits,
} from '../data/content';
import { url } from '../lib/links';
---

<Base
  title="Medios Masivos"
  path="/medios-masivos/"
  description="Nuestra base es el radio y nuestra capacidad es mucho mayor: campañas en radio con presencia nacional, parabuses y exterior, aviones, autobuses e impresos."
>
  <!-- Hero -->
  <section class="relative overflow-hidden bg-brand-800">
    <Loops class="text-white" opacity={0.2} />
    <div class="absolute inset-0 band opacity-95"></div>

    <div class="wrapper relative py-20 text-center md:py-28">
      <p class="pill mx-auto text-white/75">Medios Masivos</p>
      <h1 class="statement mx-auto mt-8 max-w-4xl text-xl text-white md:text-4xl">
        Nuestra base es el radio<br />
        <span class="font-normal tracking-[0.06em]">Nuestra capacidad es mucho mayor</span>
      </h1>
      <p class="pill mx-auto mt-10 text-white/85">Entendemos los medios desde su esencia</p>
    </div>
  </section>

  <!-- Nuestros medios -->
  <section class="bg-white">
    <div class="wrapper py-16 md:py-20">
      <!-- The Servicios list at the foot of the page, inverted: the same rule,
           rhythm and alternating weights, in crimson on white. `.pill` borders
           in currentColor, so the one colour class sets both. -->
      <p class="pill w-fit text-brand-500">Nuestros medios</p>

      <!-- Every medium jumps to the section that develops it, all of them
           further down this page — hence an arrow that points down rather than
           along. The weight alternates on the title alone, so the arrow keeps
           one weight down the column. -->
      <ul class="reveal mt-10 max-w-3xl space-y-3">
        {
          media.map(({ title, section }, i) => (
            <li class="border-b border-brand-500/20" style={`--i: ${i}`}>
              <a
                href={section}
                class="group flex items-baseline justify-between gap-4 pb-4 text-lg uppercase tracking-[0.1em] text-brand-500 transition-colors hover:text-brand-700 md:text-xl"
              >
                <span class:list={[i % 2 === 0 ? 'font-extrabold' : 'font-light']}>{title}</span>
                <span
                  aria-hidden="true"
                  class="font-normal text-brand-500/40 transition-transform group-hover:translate-y-1"
                >
                  ↓
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Radio -->
  <section id="radio" class="relative scroll-mt-24 overflow-hidden bg-brand-900">
    <Backdrop image="/img/bs-radio.jpg" imageClass="opacity-25" overlayClass="bg-brand-900/70" />

    <div class="wrapper relative grid items-center gap-12 py-16 md:py-24 lg:grid-cols-2">
      <div>
        <h2 class="text-5xl font-black uppercase tracking-tight text-white/95 md:text-7xl">
          <Outline text="Radio" width={1.5} anchor="start" />
        </h2>
        <p class="mt-8 max-w-md text-lg leading-relaxed text-white/90">{radio.text}</p>

        <p class="mt-10 flex items-baseline gap-5 border-l-2 border-brand-400 pl-5">
          <span class="text-5xl font-black text-white md:text-6xl">{radio.figure}</span>
          <span class="text-sm font-bold uppercase tracking-[0.16em] text-white/80">
            {radio.figureLabel}
          </span>
        </p>
      </div>

      <!-- How a radio buy is run, in the order the deck lists it. The sequence
           is carried by the reveal below instead of printed numerals, and by
           the <ol> itself for anyone who never sees it run. -->
      <ol class="reveal grid gap-3 sm:grid-cols-2">
        {
          radio.steps.map((step, i) => (
            <li class="flex items-center rounded-2xl border border-white/20 px-5 py-4" style={`--i: ${i}`}>
              <span class="text-sm font-bold uppercase tracking-[0.12em] text-white">{step}</span>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Medios en movimiento -->
  <section id="medios-en-movimiento" class="scroll-mt-24 bg-field">
    <div class="wrapper py-16 md:py-20">
      <!-- Same outlined display heading as Radio, in crimson: the white
           outline of the Radio version would vanish on this light field. -->
      <!-- Two lines at every width: one line of this length would run past the
           gutter from md down. The extra step below sm keeps the longer of the
           two inside the narrowest phones, where SVG text would overflow
           rather than wrap. -->
      <h2 class="text-[2.5rem] font-black uppercase tracking-tight text-brand-500 sm:text-5xl md:text-7xl">
        <Outline text={'Medios en\nmovimiento'} width={1.5} />
      </h2>

      <p class="mx-auto mt-10 max-w-2xl text-center text-xl leading-relaxed text-ink-800 md:text-2xl">
        Llevamos a las marcas más lejos, en cada etapa del viaje.
      </p>

      <!-- Each medium carries its own photograph. Both are bright and busy, so
           the card goes dark and the type turns over it: the flat tint carries
           the luminance contrast, and `on-photo` below carries the edges,
           which is the half a photograph's own texture takes away.

           Each list reveals its own formats in turn, at the same pace as the
           radio steps. The two are separate groups, so each starts when its
           own card is reached rather than both firing off the first one. -->
      <div class="mt-12 grid gap-6 md:grid-cols-2">
        {
          movingMedia.map(({ title, image, formats }) => (
            <article class="relative overflow-hidden rounded-3xl bg-brand-900 p-8 shadow-sm">
              <Backdrop image={image} imageClass="opacity-55" overlayClass="bg-brand-900/60" />

              <h3 class="on-photo relative text-sm font-black uppercase tracking-[0.16em] text-white">
                {title}
              </h3>
              <ul class="on-photo reveal relative mt-6 space-y-3.5">
                {formats.map((format, i) => (
                  <li class="flex gap-3 font-medium text-white" style={`--i: ${i}`}>
                    <span class="mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-brand-400" />
                    <span>{format}</span>
                  </li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>

      <ul class="mt-10 flex flex-wrap justify-center gap-3">
        {movingMediaTraits.map((trait) => <li class="pill border-ink-800 text-ink-900">{trait}</li>)}
      </ul>
    </div>
  </section>

  <!-- Formatos -->
  <section id="exterior-impresos" class="scroll-mt-24 bg-white">
    <div class="wrapper py-16 md:py-20">
      <div class="grid gap-6 md:grid-cols-2">
        {
          formats.map(({ title, image }) => (
            <article class="group relative overflow-hidden rounded-3xl">
              <img
                src={url(image)}
                alt=""
                loading="lazy"
                decoding="async"
                class="h-80 w-full object-cover transition-transform duration-500 group-hover:scale-105"
              />
              <div class="absolute inset-0 flex items-end bg-brand-900/30 p-8">
                <h2 class="w-full text-4xl font-black uppercase tracking-tight text-white/95 md:text-5xl">
                  <Outline text={title} width={1.5} anchor="start" />
                </h2>
              </div>
            </article>
          ))
        }
      </div>

      <p class="statement mt-12 text-center text-base text-brand-500 md:text-2xl">
        Planeamos, negociamos y ejecutamos con precisión
      </p>
    </div>
  </section>

  <!-- Best sellers masivos -->
  <section class="bg-field">
    <BandHeading class="py-6" headingClass="text-sm md:text-xl">Best sellers masivos</BandHeading>

    <p class="wrapper py-6 text-center text-lg text-brand-700 md:text-xl">
      Presencia estratégica en los espacios que construyen alcance real.
    </p>

    <div class="wrapper grid gap-6 pb-16 sm:grid-cols-2 lg:grid-cols-4 md:pb-20">
      {
        massBestSellers.map(({ title, subtitle, text, image }) => (
          <article class="overflow-hidden rounded-3xl bg-white shadow-sm">
            <img src={url(image)} alt="" loading="lazy" decoding="async" class="h-52 w-full object-cover" />
            <div class="p-6">
              <p class="text-xs font-bold uppercase tracking-[0.16em] text-brand-500">{subtitle}</p>
              <h3 class="mt-2 text-lg font-extrabold leading-snug text-ink-900">{title}</h3>
              <p class="mt-3 leading-relaxed text-ink-600">{text}</p>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <!-- Servicios -->
  <section class="relative overflow-hidden bg-brand-900">
    <Backdrop image="/img/consola.jpg" imageClass="opacity-30" overlayClass="bg-brand-900/60" />

    <div class="wrapper relative py-16 md:py-24">
      <p class="pill w-fit text-white/85">Servicios</p>
      <ul class="mt-10 max-w-3xl space-y-3">
        {
          services.map((service, i) => (
            <li
              class:list={[
                'border-b border-white/15 pb-4 text-lg uppercase tracking-[0.1em] text-white md:text-xl',
                i % 2 === 0 ? 'font-extrabold' : 'font-light',
              ]}
            >
              {service}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Cierre -->
  <section class="bg-field">
    <div class="wrapper py-16 text-center md:py-20">
      <p class="statement text-base text-ink-900 md:text-2xl">Cada espacio tiene un propósito</p>
      <p class="statement mt-3 text-base text-brand-500 md:text-2xl">
        Cada inversión tiene una lógica
      </p>

      <p class="statement mt-12 text-base text-ink-900 md:text-2xl">
        Cuando una marca necesita escala
      </p>
      {/* El logotipo va en su archivo de marca: el manual lo fija en Avenir
          Next Heavy, no en la tipografía del sitio. */}
      <img
        src={url('/img/logo-firmesa.png')}
        alt="Firmesa"
        width="760"
        height="248"
        loading="lazy"
        decoding="async"
        class="mx-auto mt-6 h-auto w-64 md:w-80"
      />
      <p class="statement mt-3 text-base text-brand-500 md:text-2xl">sabe cómo construirla</p>

      <a href={url('/contacto/')} class="btn btn-brand mt-12">Hablemos de tu proyecto</a>
    </div>
  </section>
</Base>

<style>
  /*
   * Lifts type off a photograph. The tint under it already carries the
   * luminance contrast; what a busy image takes away is edge definition,
   * where a letter's stroke meets a detail of the same brightness. A shadow
   * this small is invisible as a shadow and does only that.
   */
  .on-photo {
    text-shadow: 0 1px 3px rgb(0 0 0 / 0.55);
  }

  /*
   * Staggered reveal, used by the radio steps and the two moving-media cards.
   * Children carry `--i`, the container may tune `--stagger` and `--rise`.
   *
   * The hidden state is attached by the script below rather than written into
   * the markup, so if that never runs everything is simply there.
   */
  .reveal[data-reveal] > * {
    opacity: 0;
    transform: translateY(var(--rise, 0.75rem));
  }

  /* 110 ms apart by default: slow enough to read as a sequence, quick enough
     that the last one lands while the eye is still on the group. */
  .reveal[data-reveal='in'] > * {
    animation: reveal-in 500ms cubic-bezier(0.2, 0.7, 0.3, 1) both;
    animation-delay: calc(var(--i) * var(--stagger, 110ms));
  }

  @keyframes reveal-in {
    from { opacity: 0; transform: translateY(var(--rise, 0.75rem)); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* No reveal at all, rather than an instant one: the group is complete from
     the moment the section is reached. */
  @media (prefers-reduced-motion: reduce) {
    .reveal[data-reveal] > * {
      opacity: 1;
      transform: none;
      animation: none;
    }
  }
</style>

<script>
  // Each group reveals when it is scrolled to — both sit well below the fold,
  // and an animation nobody is looking at has already finished.
  for (const group of document.querySelectorAll<HTMLElement>('.reveal')) {
    group.dataset.reveal = 'pending';

    const observer = new IntersectionObserver(
      (entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return;
        group.dataset.reveal = 'in';
        observer.disconnect();
      },
      // Fires once the group's top clears the bottom fifth of the viewport.
      // A threshold would not do: a stacked pair of cards can be taller than a
      // phone screen, and a fraction of it may never be on screen at once.
      { threshold: 0, rootMargin: '0px 0px -20% 0px' },
    );

    observer.observe(group);
  }
</script>
