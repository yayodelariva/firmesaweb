---
import Outline from './Outline.astro';

/**
 * The deck's outlined FIRMESA wordmark. `Outline` carries the technique and
 * explains it; this only fixes the word and the fact that it is decorative —
 * wherever it appears, the page's real heading is a separate element.
 */
interface Props {
  /** Width of the visible outline, in px. */
  width?: number;
  class?: string;
}
const { width = 2, class: className = '' } = Astro.props;
---

<Outline text="FIRMESA" width={width} decorative class={className} />
