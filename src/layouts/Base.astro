---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, url } from '../data/site';

interface Props {
  titulo: string;
  descripcion?: string;
  /** Ruta canónica, ej. "/servicios/" */
  ruta?: string;
}

const { titulo, descripcion = site.descripcion, ruta = Astro.url.pathname } = Astro.props;
const tituloCompleto = ruta === '/' ? `${site.nombre} — Representación de radiodifusoras en México` : `${titulo} | ${site.nombre}`;
// Origen real de la publicación (config `site` de Astro); `site.dominio` es el respaldo.
const origen = Astro.site ?? new URL(site.dominio);
/** URL absoluta de una ruta interna, respetando el `base` del despliegue. */
const absoluta = (r: string) => new URL(url(r), origen).href;
const canonica = absoluta(ruta);
---

<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonica} />
    <link rel="icon" href={url('/img/logo-icono.png')} type="image/png" />
    <meta name="theme-color" content="#990033" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.nombre} />
    <meta property="og:locale" content="es_MX" />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonica} />
    <meta property="og:image" content={absoluta('/img/logo-firmesa.png')} />
    <meta name="twitter:card" content="summary" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700;800&family=Inter:wght@400;500;600&display=swap"
    />

    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'Organization',
        name: site.nombre,
        legalName: site.razonSocial,
        url: origen.href,
        logo: absoluta('/img/logo-firmesa.png'),
        foundingDate: '1972-07-19',
        description: site.descripcion,
        areaServed: 'MX',
        sameAs: [site.facebook],
        contactPoint: site.telefonos.map((t) => ({
          '@type': 'ContactPoint',
          telephone: `+52 ${t}`,
          contactType: 'sales',
          areaServed: 'MX',
          availableLanguage: 'Spanish',
        })),
      })}
    />
  </head>

  <body class="antialiased">
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-brand-600 focus:px-4 focus:py-2 focus:text-white"
    >
      Saltar al contenido
    </a>
    <Header />
    <main id="contenido">
      <slot />
    </main>
    <Footer />
  </body>
</html>
