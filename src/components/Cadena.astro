---
import { url } from '../lib/links';

/**
 * "Cadena para textura" del Manual de identidad: el contorno de la marca,
 * ampliado detrás del contenido.
 *
 * The traced contour is ~7 kB of path data and appears several times on every
 * page, so it ships as a static file the browser caches once instead of being
 * inlined into each section. That rules out `currentColor`, hence the two
 * prepared tones.
 *
 * `object-cover` crops rather than squashes: on a tall section the whole chain
 * reads, on a thin band only a couple of its curves do — which is how the
 * manual applies it.
 */
interface Props {
  /** Over a dark or crimson surface, or over a light one. */
  tone?: 'blanca' | 'crimson';
  /** 0–1. The manual keeps the texture at the edge of visibility. */
  opacity?: number;
  class?: string;
}
const { tone = 'blanca', opacity = 0.18, class: className = '' } = Astro.props;
---

<img
  src={url(`/img/cadena-${tone}.svg`)}
  alt=""
  aria-hidden="true"
  loading="lazy"
  decoding="async"
  class:list={['pointer-events-none absolute inset-0 h-full w-full object-cover', className]}
  style={`opacity:${opacity}`}
/>
