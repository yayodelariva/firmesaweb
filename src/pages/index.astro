---
import Base from '../layouts/Base.astro';
import Backdrop from '../components/Backdrop.astro';
import BandHeading from '../components/BandHeading.astro';
import Loops from '../components/Loops.astro';
import { site, decades } from '../data/site';
import { worlds, territory, clients, singleVision, rotating } from '../data/content';
import { url } from '../lib/links';
---

<Base title="Inicio" path="/">
  <!-- Hero -->
  <section class="relative overflow-hidden bg-brand-900">
    <Backdrop
      image="/img/hero-inicio.jpg"
      imageClass="opacity-45"
      overlayClass="bg-gradient-to-br from-brand-900 via-brand-800/85 to-brand-700/80"
      priority
    />
    <Loops class="text-white" opacity={0.16} />

    <div class="wrapper relative py-24 text-center md:py-32">
      <p class="pill mx-auto text-white/70">Desde 1972</p>

      <!-- Logotipo primario del manual, versión en blanco. El manual fija el
           logotipo en Avenir Next Heavy, así que es el archivo de marca y no
           texto compuesto con la tipografía del sitio. -->
      <img
        src={url('/img/logo-firmesa-vertical-blanco.png')}
        alt=""
        width="347"
        height="390"
        fetchpriority="high"
        class="mx-auto mt-10 h-auto w-48 sm:w-60 lg:w-72"
      />

      <p class="mt-6 text-base font-bold text-white/90 md:text-xl">{site.slogan}</p>

      <h1 class="mt-10 text-3xl font-extrabold leading-tight text-white sm:text-4xl md:text-5xl">
        <span class="sr-only">Creamos campañas, marcas y posicionamiento.</span>
        <span aria-hidden="true" class="block">Creamos</span>
        <span aria-hidden="true" class="rotator mt-2 grid justify-items-center">
          {
            rotating.map((word, i) => (
              <span class="col-start-1 row-start-1 text-brand-200" style={`--i:${i}`}>
                {word}
              </span>
            ))
          }
        </span>
      </h1>

      <p class="mx-auto mt-8 max-w-2xl text-lg leading-relaxed text-ink-200">
        No se trata de estar en todos lados. <strong class="font-bold text-white">Se trata de estar donde importa.</strong>
      </p>

      <div class="mt-10 flex flex-wrap justify-center gap-4">
        <a href={url('/contacto/')} class="btn btn-brand">Hablemos de tu proyecto</a>
        <a href={url('/medios-masivos/')} class="btn btn-ghost">Conoce lo que hacemos</a>
      </div>
    </div>
  </section>

  <!-- Positioning statement -->
  <section class="bg-white">
    <div class="wrapper max-w-4xl py-20 text-center md:py-24">
      <p class="statement text-xl text-ink-900 md:text-3xl">
        No somos una agencia,<br />somos una central de medios
      </p>
      <p class="mx-auto mt-8 max-w-2xl leading-relaxed text-ink-600">
        Conectamos estrategia, creatividad, producción y medios para construir soluciones
        integrales de comunicación.
      </p>

      <hr class="mx-auto my-12 w-24 border-t-2 border-brand-500" />

      <p class="text-xl leading-relaxed text-ink-800 md:text-2xl">
        Firmesa es la <strong class="font-extrabold">central de medios y partner estratégico</strong>
        {' '}que posiciona marcas con precisión.
      </p>
      <p class="mt-6 text-xl leading-relaxed text-ink-600 md:text-2xl">
        <strong class="font-extrabold text-brand-500">Más de {decades()} años construyendo marcas.</strong>
        {' '}Hoy, integrando medios masivos y digitales en un solo sistema.
      </p>
    </div>
  </section>

  <!-- Lo mejor de dos mundos -->
  <section class="relative overflow-hidden bg-brand-900">
    <Backdrop image="/img/textura-acustica.jpg" imageClass="opacity-25" overlayClass="bg-brand-900/70" />

    <div class="relative">
      <BandHeading class="py-4" loops={false}>Lo mejor de dos mundos</BandHeading>

      <div class="wrapper grid gap-8 py-16 md:grid-cols-2 md:py-20">
        {
          worlds.map(({ label, href, image, text }) => (
            <a href={url(href)} class="group block">
              <div class="overflow-hidden rounded-3xl border border-white/15">
                <div class="relative">
                  <img
                    src={url(image)}
                    alt=""
                    loading="lazy"
                    decoding="async"
                    class="h-64 w-full object-cover transition-transform duration-500 group-hover:scale-105 md:h-72"
                  />
                  <div class="absolute inset-0 flex items-center justify-center bg-brand-900/25">
                    <span class="pill bg-brand-900/40 text-white backdrop-blur-sm">{label}</span>
                  </div>
                </div>
              </div>
              <p class="mt-6 text-xl font-bold leading-snug text-white md:text-2xl">{text}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Territorio -->
  <section class="bg-field">
    <BandHeading>Territorio</BandHeading>

    <div class="wrapper grid gap-6 py-16 md:grid-cols-3 md:py-20">
      {
        territory.map(({ title, image }) => (
          <article class="overflow-hidden rounded-3xl bg-white shadow-sm">
            <img src={url(image)} alt="" loading="lazy" decoding="async" class="h-64 w-full object-cover" />
            <h3 class="band px-6 py-6 text-center text-lg font-extrabold uppercase leading-snug tracking-wide text-white">
              {title}
            </h3>
          </article>
        ))
      }
    </div>
  </section>

  <!-- La integramos -->
  <section class="relative overflow-hidden bg-brand-900">
    <Backdrop image="/img/integramos.jpg" imageClass="opacity-40" overlayClass="bg-brand-900/55" />

    <div class="relative py-20 md:py-24">
      <div class="bg-field/95 py-8">
        <div class="wrapper text-center">
          <p class="statement text-sm text-ink-600 md:text-xl">
            No dividimos la <span class="text-brand-500">comunicación</span>
          </p>
          <p class="mt-2 text-4xl font-black uppercase tracking-tight text-brand-500 md:text-6xl">
            La integramos
          </p>
        </div>
      </div>

      <p class="wrapper mt-10 max-w-4xl text-center text-xl leading-relaxed text-white md:text-2xl">
        Estrategia, data, creatividad, medios y ejecución trabajando juntos para lograr resultados
        reales.
      </p>
    </div>
  </section>

  <!-- Una sola visión -->
  <section class="bg-white">
    <div class="wrapper py-16 md:py-20">
      <p class="pill mx-auto block w-fit border-ink-800 text-ink-900">Una sola visión</p>
      <p class="mx-auto mt-8 max-w-2xl text-center text-xl leading-relaxed text-ink-800 md:text-2xl">
        Una misma idea puede nacer, producirse y amplificarse desde Firmesa.
      </p>

      <!-- Four columns, in the order an idea travels through them. -->
      <ol class="mt-12 grid gap-px overflow-hidden rounded-3xl bg-ink-200 sm:grid-cols-2 lg:grid-cols-4">
        {
          singleVision.map(({ title, items }) => (
            <li class="bg-white p-8">
              <h3 class="text-sm font-black uppercase tracking-[0.16em] text-brand-500">{title}</h3>
              <ul class="mt-5 space-y-2 text-ink-600">
                {items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </li>
          ))
        }
      </ol>
    </div>

    <BandHeading as="p" headingClass="text-xs md:text-sm">De una idea, a un mayor impacto</BandHeading>
  </section>

  <!-- Clientes -->
  <section class="bg-field">
    <div class="wrapper py-16 text-center md:py-20">
      <p class="pill mx-auto border-ink-300 text-ink-800">Marcas que han confiado en nosotros</p>
      <p class="mx-auto mt-8 max-w-2xl text-xl text-ink-800">
        Diferentes industrias, un mismo objetivo: conectar con las personas.
      </p>
      {/* Nombres, no logotipos: las marcas de terceros necesitan su permiso. */}
      <ul class="mt-10 flex flex-wrap justify-center gap-3">
        {
          clients.map((client) => (
            <li class="rounded-full border border-ink-300 bg-white px-6 py-3 text-sm font-bold text-ink-800">
              {client}
            </li>
          ))
        }
      </ul>
      <p class="statement mt-14 text-sm text-brand-500 md:text-xl">
        Cada proyecto parte de una decisión
      </p>
    </div>
    <BandHeading as="p" loops={false}>Nuestro trabajo es que esa decisión funcione</BandHeading>
  </section>

  <!-- Cierre -->
  <section class="relative overflow-hidden bg-brand-900">
    <Backdrop image="/img/cierre-tablet.jpg" imageClass="opacity-35" overlayClass="bg-brand-900/60" />

    <div class="wrapper relative py-20 text-center md:py-28">
      <p class="statement text-lg text-white md:text-3xl">
        Cuando la estrategia es correcta<br />la ejecución es contundente
      </p>
      <a href={url('/contacto/')} class="btn btn-light mt-10">Agenda una llamada estratégica</a>
    </div>
  </section>
</Base>

<style>
  /* Rotating word in the hero headline. */
  .rotator > span {
    opacity: 0;
    animation: rotate-word 7.5s infinite;
    animation-delay: calc(var(--i) * 2.5s);
  }

  /*
   * Three words, 2.5 s each. Each word holds until exactly the point its
   * successor starts fading in (2.5 s / 7.5 s = 33.33 %), so the two cross
   * rather than leaving the line blank between them.
   */
  @keyframes rotate-word {
    0% { opacity: 0; transform: translateY(0.35em); }
    5%, 33.33% { opacity: 1; transform: translateY(0); }
    38.33%, 100% { opacity: 0; transform: translateY(-0.35em); }
  }

  @media (prefers-reduced-motion: reduce) {
    .rotator > span { animation: none; opacity: 0; }
    .rotator > span:first-child { opacity: 1; }
  }
</style>
