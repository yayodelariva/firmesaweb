---
import { nav, site } from '../data/site';

const actual = Astro.url.pathname;
const activo = (href: string) => (href === '/' ? actual === '/' : actual.startsWith(href));
---

<header class="sticky top-0 z-40 border-b border-ink-100 bg-white/90 backdrop-blur">
  <div class="contenedor flex h-18 items-center justify-between gap-6 py-3">
    <a href="/" class="flex items-center gap-3" aria-label={`${site.nombre} — Inicio`}>
      <img src="/img/logo-firmesa.png" alt="" width="44" height="44" class="h-11 w-11" />
      <span class="flex flex-col leading-none">
        <span class="font-display text-xl font-extrabold tracking-tight text-ink-900">FIRMESA</span>
        <span class="mt-1 text-[0.6875rem] font-medium uppercase tracking-[0.16em] text-ink-400">
          Radiodifusoras
        </span>
      </span>
    </a>

    <nav aria-label="Principal" class="hidden items-center gap-1 lg:flex">
      {
        nav.map(({ href, label }) => (
          <a
            href={href}
            aria-current={activo(href) ? 'page' : undefined}
            class:list={[
              'rounded-md px-3 py-2 text-sm font-medium transition-colors',
              activo(href)
                ? 'text-brand-600'
                : 'text-ink-600 hover:bg-ink-50 hover:text-ink-900',
            ]}
          >
            {label}
          </a>
        ))
      }
      <a
        href="/contacto/"
        class="ml-3 rounded-md bg-brand-600 px-4 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-brand-700"
      >
        Cotizar campaña
      </a>
    </nav>

    <button
      type="button"
      id="menu-boton"
      class="inline-flex items-center gap-2 rounded-md border border-ink-200 px-3 py-2 text-sm font-medium text-ink-800 lg:hidden"
      aria-expanded="false"
      aria-controls="menu-movil"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round" />
      </svg>
      Menú
    </button>
  </div>

  <nav id="menu-movil" aria-label="Principal móvil" hidden class="border-t border-ink-100 bg-white lg:hidden">
    <ul class="contenedor flex flex-col py-2">
      {
        nav.map(({ href, label }) => (
          <li>
            <a
              href={href}
              aria-current={activo(href) ? 'page' : undefined}
              class:list={[
                'block border-b border-ink-100 py-3.5 text-base font-medium',
                activo(href) ? 'text-brand-600' : 'text-ink-800',
              ]}
            >
              {label}
            </a>
          </li>
        ))
      }
      <li class="py-4">
        <a
          href="/contacto/"
          class="block rounded-md bg-brand-600 px-4 py-3 text-center text-sm font-semibold text-white"
        >
          Cotizar campaña
        </a>
      </li>
    </ul>
  </nav>
</header>

<script>
  const boton = document.getElementById('menu-boton');
  const menu = document.getElementById('menu-movil');

  boton?.addEventListener('click', () => {
    const abierto = boton.getAttribute('aria-expanded') === 'true';
    boton.setAttribute('aria-expanded', String(!abierto));
    menu?.toggleAttribute('hidden', abierto);
  });
</script>
