---
import { nav, site, url } from '../data/site';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// Current path without the `base` prefix, so it can be compared against the nav.
const current = Astro.url.pathname.slice(base.length) || '/';
const isActive = (href: string) => (href === '/' ? current === '/' : current.startsWith(href));
---

<header class="sticky top-0 z-40 border-b border-ink-100 bg-white/90 backdrop-blur">
  <div class="wrapper flex h-18 items-center justify-between gap-6 py-3">
    <a href={url('/')} class="flex items-center gap-3" aria-label={`${site.name} — Inicio`}>
      <img src={url('/img/logo-firmesa.png')} alt="" width="44" height="44" class="h-11 w-11" />
      <span class="flex flex-col leading-none">
        <span class="font-display text-xl font-extrabold tracking-tight text-ink-900">FIRMESA</span>
        <span class="mt-1 text-[0.6875rem] font-medium uppercase tracking-[0.16em] text-ink-400">
          Radiodifusoras
        </span>
      </span>
    </a>

    <nav aria-label="Principal" class="hidden items-center gap-1 lg:flex">
      {
        nav.map(({ href, label }) => (
          <a
            href={url(href)}
            aria-current={isActive(href) ? 'page' : undefined}
            class:list={[
              'rounded-md px-3 py-2 text-sm font-medium transition-colors',
              isActive(href)
                ? 'text-brand-600'
                : 'text-ink-600 hover:bg-ink-50 hover:text-ink-900',
            ]}
          >
            {label}
          </a>
        ))
      }
      <a
        href={url('/contacto/')}
        class="ml-3 rounded-md bg-brand-600 px-4 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-brand-700"
      >
        Cotizar campaña
      </a>
    </nav>

    <button
      type="button"
      id="menu-button"
      class="inline-flex items-center gap-2 rounded-md border border-ink-200 px-3 py-2 text-sm font-medium text-ink-800 lg:hidden"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round" />
      </svg>
      Menú
    </button>
  </div>

  <nav id="mobile-menu" aria-label="Principal móvil" hidden class="border-t border-ink-100 bg-white lg:hidden">
    <ul class="wrapper flex flex-col py-2">
      {
        nav.map(({ href, label }) => (
          <li>
            <a
              href={url(href)}
              aria-current={isActive(href) ? 'page' : undefined}
              class:list={[
                'block border-b border-ink-100 py-3.5 text-base font-medium',
                isActive(href) ? 'text-brand-600' : 'text-ink-800',
              ]}
            >
              {label}
            </a>
          </li>
        ))
      }
      <li class="py-4">
        <a
          href={url('/contacto/')}
          class="block rounded-md bg-brand-600 px-4 py-3 text-center text-sm font-semibold text-white"
        >
          Cotizar campaña
        </a>
      </li>
    </ul>
  </nav>
</header>

<script>
  const button = document.getElementById('menu-button');
  const menu = document.getElementById('mobile-menu');

  button?.addEventListener('click', () => {
    const isOpen = button.getAttribute('aria-expanded') === 'true';
    button.setAttribute('aria-expanded', String(!isOpen));
    menu?.toggleAttribute('hidden', isOpen);
  });
</script>
